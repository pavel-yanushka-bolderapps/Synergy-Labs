---
// /about-us -- linked from the nav since the nav was written, never built.
//
// Only the hero is specific to this page. Everything under it is the same
// component the homepage renders, reading the same `home` content, so the two
// pages stay in step by construction rather than by copy.
import { aboutPage as aboutPageSchema, breadcrumbs } from "../lib/structuredData";
import Layout from "../components/layout/Layout.astro";
import AboutHero from "../components/sections/AboutHero.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import HowWeWork from "../components/sections/HowWeWork.astro";
import Team from "../components/sections/Team.astro";
import SelectedWorks from "../components/sections/SelectedWorks.astro";
import Badges from "../components/sections/Badges.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import { aboutPage } from "../content/aboutPage";
import { home } from "../content/home";
import { withExistingCaseStudies } from "../lib/sanity";

// Same as the homepage grid: only link projects that actually have a page.
const selectedWorks = {
  ...home.selectedWorks,
  items: await withExistingCaseStudies(home.selectedWorks.items),
};

---

<Layout
  title="About Us | Synergy Labs - Top App Development Agency"
  description="Meet the Synergy Labs team. US-based app development with 10-week timelines, scope-based budgets, and boutique approach. 5M+ users served."
  jsonLd={[aboutPageSchema(), breadcrumbs([{ name: "About Us", path: "/about-us" }])]}
>
  <AboutHero content={aboutPage.hero} />
  <WhyUs content={home.whyUs} />
  <HowWeWork content={home.howWeWork} />
  <Team content={home.team} />
  <SelectedWorks content={selectedWorks} />
  <Badges content={home.badges} />
  <ContactSection />
</Layout>
