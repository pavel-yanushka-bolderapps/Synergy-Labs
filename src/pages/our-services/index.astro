---
import { breadcrumbs, collectionPage } from "../../lib/structuredData";
import { stegaClean } from "@sanity/client/stega";
import Layout from "../../components/layout/Layout.astro";
import ServicesGrid from "../../components/sections/ServicesGrid.astro";
import ContactSection from "../../components/sections/ContactSection.astro";
import { ourServicesPage } from "../../content/ourServicesPage";
import { getServices } from "../../lib/sanity";

// Same source as the homepage grid (see src/pages/index.astro). This page
// used to read the static list directly, which meant the detail pages --
// built from the `href` on each Sanity document -- and the cards linking to
// them could drift apart: three links here still pointed at the pre-Sanity
// slugs and 404'd. Reading Sanity in both places keeps a card and the page
// it opens on the same URL by construction.
const sanityServices = await getServices();
const servicesContent = {
  heading: "So you just do apps? Nope, we do a lil more",
  items: sanityServices ?? ourServicesPage.items,
};

---

<Layout
  title="Custom Software, App & Web Development Services | Synergy Labs"
  description="Explore Synergy Labs’ full range of digital services—from mobile apps and web apps to AI and marketing. Custom-built tech that scales with your business."
  jsonLd={[
    collectionPage({
      name: "Custom Software, App & Web Development Services",
      description:
        "Explore Synergy Labs’ full range of digital services—from mobile apps and web apps to AI and marketing. Custom-built tech that scales with your business.",
      path: "/our-services",
      items: servicesContent.items.map((item) => ({
        type: "Service",
        name: stegaClean(item.title) as string,
        path: item.href,
        image: item.imageSrc,
      })),
    }),
    breadcrumbs([{ name: "Our Services", path: "/our-services" }]),
  ]}
>
  <section class="mx-auto max-w-3xl px-6 pt-20 text-center md:pt-28">
    <h1 class="font-display text-4xl leading-tight md:text-5xl">{ourServicesPage.heading}</h1>
    <p class="mt-6 text-lg text-black/70">{ourServicesPage.subheading}</p>
  </section>

  <ServicesGrid content={servicesContent} class="pt-10 pb-20 md:pt-12" />

  <ContactSection />
</Layout>
