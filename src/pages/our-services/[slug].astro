---
import Layout from "../../components/layout/Layout.astro";
import Lottie from "../../components/Lottie.astro";
import RatingBadge from "../../components/RatingBadge.astro";
import ServiceFeatures from "../../components/sections/ServiceFeatures.astro";
import ServiceValues from "../../components/sections/ServiceValues.astro";
import ServiceProcess from "../../components/sections/ServiceProcess.astro";
import HowWeWork from "../../components/sections/HowWeWork.astro";
import WhyUs from "../../components/sections/WhyUs.astro";
import Reviews from "../../components/sections/Reviews.astro";
import Badges from "../../components/sections/Badges.astro";
import FAQ from "../../components/sections/FAQ.astro";
import ContactSection from "../../components/sections/ContactSection.astro";
import { home } from "../../content/home";
import { serviceDetailPage } from "../../content/serviceDetailPage";
import { getServiceSlugs, getServiceBySlug, type ServiceDetail } from "../../lib/sanity";

// Static-output route: every service page is generated at build time from
// whatever "service" documents exist in Sanity right now. There is no
// static-content fallback here (unlike the homepage Services grid) -- a
// service only gets a page if it has a matching Sanity document when the
// site is built. Publishing a new service in Studio requires a rebuild
// (git push / redeploy, or a Sanity webhook -> Vercel deploy hook) before
// its page appears live, same as everywhere else Sanity content is used.
//
// The same is true of `npm run dev`, which trips people up: Astro calls
// getStaticPaths once per dev-server session and caches the result, so
// publishing in Studio and reloading the page shows the OLD content and
// looks like the edit didn't save. It did -- restart the dev server (or
// save this file) to re-run the query.
export async function getStaticPaths() {
  const slugs = await getServiceSlugs();
  const details = await Promise.all(slugs.map((slug) => getServiceBySlug(slug)));

  return slugs
    .map((slug, i) => ({ params: { slug }, props: { service: details[i] } }))
    .filter((entry): entry is { params: { slug: string }; props: { service: ServiceDetail } } =>
      entry.props.service !== null
    );
}

const { service } = Astro.props;
// Editors break the heading onto a second line with a plain Enter in the
// Studio's text field, same convention as the homepage hero's heading.
const headingLines = service.heroHeading.split("\n");
---

<Layout title={`${service.title} | Synergy Labs`} description={service.metaDescription}>
  <section class="relative overflow-hidden">
    <img
      src="/images/Hero-Bg.svg"
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-40"
    />

    <div class="relative mx-auto max-w-7xl px-6 py-20 md:py-28">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h1 class="font-display text-4xl leading-tight md:text-5xl">
            {headingLines.map((line, i) => (
              <>
                {line}
                {i < headingLines.length - 1 && <br />}
              </>
            ))}
          </h1>
          <RatingBadge content={serviceDetailPage.ratingBadge} class="mt-6" />
          {service.heroDescription && (
            <p class="mt-6 text-lg text-black/70">{service.heroDescription}</p>
          )}
          <a
            href="#contact-form"
            class="mt-8 inline-block rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green"
          >
            Explore
          </a>
        </div>

        {/* The hero visual is a Lottie animation on most services and a
            still image on the rest (see the `heroLottie` / `heroImage`
            fields in src/sanity/schemaTypes/service.ts), so the animation
            wins wherever one is uploaded and the image stays the fallback.
            The wrapper reserves the animation's own aspect ratio -- a
            <canvas> has no intrinsic size of its own -- falling back to a
            square when the build couldn't read it. */}
        {service.heroLottieSrc ? (
          <div
            class="w-full overflow-hidden rounded-2xl"
            style={`aspect-ratio: ${service.heroLottieAspectRatio ?? "1 / 1"}`}
          >
            <Lottie src={service.heroLottieSrc} class="h-full w-full" />
          </div>
        ) : service.heroImageSrc ? (
          <img src={service.heroImageSrc} alt="" class="w-full rounded-2xl object-cover" />
        ) : null}
      </div>
    </div>
  </section>

  {service.bannerWords.length > 0 && (
    <section class="overflow-hidden bg-secondary-green py-6 text-white">
      <div class="banner-marquee flex">
        {[0, 1].map((copy) => (
          <div
            class="banner-group flex shrink-0 items-center justify-around gap-10 whitespace-nowrap"
            aria-hidden={copy === 1 ? "true" : undefined}
          >
            {service.bannerWords.map((word) => (
              <span class="text-lg font-semibold">{word}</span>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  {service.features && <ServiceFeatures content={service.features} />}

  <ServiceValues cards={service.valueCards} />

  <!-- A service with its own stages shows those; the rest keep the generic
       homepage process block, so no page loses the section entirely. Both
       are titled "How We Work", so they must never render together. -->
  {service.process ? (
    <ServiceProcess content={service.process} />
  ) : (
    <HowWeWork content={home.howWeWork} />
  )}
  <WhyUs content={home.whyUs} />
  <Reviews content={home.reviews} />
  <Badges content={home.badges} />
  <FAQ content={home.faq} />
  <ContactSection id="contact-form" />
</Layout>

<style>
  /* Two identical groups side by side, each animating the full width of one
     group. When group 1 has slid entirely out to the left, group 2 sits
     exactly where group 1 began, so the restart is invisible.

     The earlier version put one flex row of doubled words on a w-max track
     and moved it -50%. That only works while the doubled row is wider than
     the screen: with five short phrases it was not, so the row ran out and
     left a bare green gap on the right before snapping back.

     min-width: 100% is what fixes that -- it forces each group to be at
     least as wide as the section no matter how few or how short the words
     are, and justify-content spreads them across it. */
  .banner-group {
    min-width: 100%;
    animation: banner-scroll 20s linear infinite;
  }

  @keyframes banner-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-group {
      animation: none;
    }
  }
</style>
