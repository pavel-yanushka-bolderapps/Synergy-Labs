---
// One office's page, e.g. /locations/miami.
//
// Section order follows the original Webflow page: hero, reviews, success
// stories, services, industries, process, service area, FAQ, why-us, contact
// details, stats, awards, map, form.
//
// Every section is conditional. The source collection is unevenly filled --
// 21 of the 26 offices have the full treatment, the five international ones
// carry only a heading and a couple of paragraphs -- so rendering a section
// only when it has content gives a thin office a genuinely shorter page
// instead of a run of empty headings.
//
// Four sections are heading-and-intro only for now: Services, Industries,
// Process and FAQ each hang off a separate Webflow collection (92 services,
// 104 industries, 6 steps, 64 FAQs) that the Locations export references by
// slug and does not contain. The cards/accordion items drop in underneath
// once those exports land; the copy above them is already here.
import Layout from "../../components/layout/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
import WorkCard from "../../components/sections/locations/WorkCard.astro";
import Badges from "../../components/sections/Badges.astro";
import Stats from "../../components/sections/Stats.astro";
import FAQ from "../../components/sections/FAQ.astro";
import { home } from "../../content/home";
import { portfolioPage } from "../../content/portfolio";
import { locationProcess } from "../../content/locationProcess";
import { getLocationDetails } from "../../lib/sanity";
import type { LocationDetail } from "../../lib/types";

export async function getStaticPaths() {
  const locations = await getLocationDetails();
  return locations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

interface Props {
  location: LocationDetail;
}

const { location } = Astro.props;

const heading = location.mainHeading?.trim() || `${location.city} Office`;

// The CSV carries the `pb=` parameter blob rather than a whole URL, so build
// the embed around it here.
const mapSrc = location.mapCode ? `https://www.google.com/maps/embed?pb=${location.mapCode}` : null;

// Emitted verbatim into a <script type="application/ld+json">, so it has to be
// parseable -- a broken blob would be invalid structured data published under
// our name. Parse and re-serialise rather than trusting the field. (The
// Atlanta entry arrived as a JS object literal, single-quoted throughout.)
let structuredData: string | null = null;
if (location.jsonLd) {
  try {
    structuredData = JSON.stringify(JSON.parse(location.jsonLd));
  } catch {
    console.warn(`[locations] ${location.slug}: JSON-LD is not valid JSON, skipping it.`);
  }
}

// The FAQ is location-specific in Webflow, but the generic set the original
// page also carries is the one already in home.ts -- so an office without its
// own questions still gets an answered accordion rather than a bare heading.
const faq = { heading: location.faqHeading?.trim() || home.faq.heading, items: home.faq.items };

// The three badges the original prints in the hero, as opposed to the seven
// in the "Our Humble Recognitions" marquee further down.
const heroAwards = [
  { src: "/images/carousel-badge-01.jpg", alt: "Forbes Technology Council 2025 official member" },
  { src: "/images/Google-Certification.webp", alt: "Google Agency Program certified agency" },
  { src: "/images/awards1_1awards1.avif", alt: "Clutch Global Fall 2024 award" },
];

// Success stories are the same two projects on every location page in the
// original, so they come from the portfolio content rather than the CMS --
// which also keeps their copy, metrics and case-study links in one place.
const services = location.services ?? [];
// A row with no illustration is half a row -- the copy alone in a two-column
// grid reads as a layout bug rather than a deliberate variation -- so those
// are dropped. Ten of the 104 industry records have no artwork.
const industries = (location.industries ?? []).filter((industry) => industry.imageSrc);

const technologies = location.technologies ?? [];
const hasTechnologies = Boolean(location.technologiesHeading && (location.techStack || technologies.length > 0));

const SUCCESS_STORY_SLUGS = ["fanbase", "signal"];
const successStories = SUCCESS_STORY_SLUGS.map((slug) =>
  portfolioPage.items.find((item) => item.slug === slug)
).filter((item) => item !== undefined);
---

<Layout
  title={`${location.city} | Synergy Labs`}
  description={location.mainDescription ?? `Synergy Labs' ${location.city} office: ${location.address}.`}
>
  {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}

  <!--
    Two columns: everything that scrolls on the left, the form pinned on the
    right. The reviews and the success stories live *inside* the left column
    rather than as full-width bands below, which is what keeps the form
    alongside them all the way down the page.
  -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <!--
      55/45, and it only stacks below 880px. `lg:` (1024px) put the form under
      the content on every tablet and small laptop, which is exactly where a
      form beside the copy is still worth having.
    -->
    <div class="grid gap-12 min-[880px]:grid-cols-[55fr_45fr] min-[880px]:gap-12">
      <div class="min-w-0">
        <h1 class="font-sans text-4xl font-bold uppercase leading-[1.1] text-primary-green md:text-5xl">
          {heading}
        </h1>

        {location.mainDescription && (
          <p class="mt-8 text-lg leading-relaxed text-black/80">{location.mainDescription}</p>
        )}

        <div class="mt-10">
          <p class="font-semibold">Some of our awards:</p>
          <div class="mt-5 grid grid-cols-3 items-center gap-6">
            {heroAwards.map((award) => (
              <img src={award.src} alt={award.alt} loading="lazy" class="h-auto w-full object-contain" />
            ))}
          </div>
        </div>

        <div class="mt-16">
          <h2 class="font-sans text-3xl font-bold uppercase text-black md:text-4xl">Reviews from Clutch</h2>
          <!--
            The widget is the same one the homepage Reviews section embeds. Its
            script is loaded once per page by the tag below; the widget div is
            what it looks for.
          -->
          <div
            class="clutch-widget mt-8"
            data-url="https://widget.clutch.co"
            data-widget-type="12"
            data-height="375"
            data-nofollow="true"
            data-expandifr="true"
            data-scale="100"
            data-primary-color="#007244"
            data-secondary-color="#007244"
            data-reviews="321740,320396,318762,312273,308672,307983,300535,299448,297518,297389,297117,295546"
            data-clutchcompany-id="2373941"
          >
          </div>
        </div>

        {successStories.length > 0 && (
          <div class="mt-16">
            <h2 class="font-sans text-3xl font-bold uppercase text-black md:text-4xl">Success stories</h2>
            <div class="mt-8 flex flex-col gap-8">
              {successStories.map((item) => <WorkCard item={item} />)}
            </div>
          </div>
        )}
      </div>

      <!--
        `self-start` is what makes the sticky work: a grid item stretches to
        the row height by default, so there is nothing left to slide against.
      -->
      <div class="min-[880px]:sticky min-[880px]:top-24 min-[880px]:self-start">
        <div id="contact-form-wrapper">
          <ContactForm class="overflow-hidden rounded-3xl bg-secondary p-5 shadow-xl md:p-8" />
        </div>

        <div id="contact-success" class="hidden flex-col items-center rounded-3xl bg-secondary p-10 text-center shadow-xl">
          <div class="flex h-16 w-16 items-center justify-center rounded-full bg-secondary-green text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-8 w-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
          </div>
          <h2 class="mt-6 font-display text-2xl">Thanks -- we got your message!</h2>
          <p class="mt-4 text-black/70">
            Our director of product will reach out shortly to schedule your call.
          </p>
        </div>
      </div>
    </div>
    </div>
  </section>

  <script is:inline type="text/javascript" src="https://widget.clutch.co/static/js/widget.js"></script>

  {location.servicesHeading && location.servicesDescription && (
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 md:grid-cols-2 md:gap-16">
        <div class="min-w-0">
          <h2 class="font-display text-3xl leading-tight md:text-4xl">{location.servicesHeading}</h2>
          <p class="mt-6 text-lg leading-relaxed text-black/70">{location.servicesDescription}</p>
          <a
            href="#contact-form"
            class="mt-8 inline-block rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green"
          >
            Free quote
          </a>
        </div>
        <img
          src="/images/Locations/services-map.webp"
          alt=""
          loading="lazy"
          class="w-full rounded-2xl object-contain"
        />
      </div>
    </section>
  )}

  {services.length > 0 && (
    <section class="bg-secondary py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-center font-sans text-3xl font-bold uppercase md:text-4xl">Our services</h2>

      <!--
        Image-and-copy rows that alternate sides. The order swap is done with
        grid-column on the odd rows rather than by reversing the markup, so the
        reading order stays heading-then-copy for a screen reader however the
        row is laid out.
      -->
      <div class="mt-12 flex flex-col gap-12 md:gap-16">
        {services.map((service, i) => (
          <article class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
            <div class:list={["min-w-0", i % 2 === 1 && "md:col-start-2 md:row-start-1"]}>
              <img
                src={service.imageSrc}
                alt=""
                loading="lazy"
                class="aspect-[3/2] w-full rounded-2xl object-cover"
              />
              <h3 class="mt-6 font-display text-xl leading-tight md:text-2xl">{service.title}</h3>
            </div>
            <p class:list={["leading-relaxed text-black/70", i % 2 === 1 && "md:col-start-1 md:row-start-1"]}>
              {service.description}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="#contact-form"
          class="inline-block rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green"
        >
          Free quote
        </a>
      </div>
      </div>
    </section>
  )}

  {location.industriesHeading && (
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
      <h2 class="font-sans text-3xl font-bold uppercase md:text-4xl">{location.industriesHeading}</h2>
      {location.industriesDescription && (
        <p class="mt-4 max-w-3xl leading-relaxed text-black/70">{location.industriesDescription}</p>
      )}

      {industries.length > 0 && (
        <div class="mt-10 flex flex-col">
          {industries.map((industry) => (
            <article class="w-full">
              <!--
                The rule is an element, not a border, so it can be drawn. The
                wrapper holds the full width and the line inside it starts at
                0% -- the observer at the foot of this file flips it to 100%
                once the row scrolls into view.
              -->
              <div class="location-rule relative w-full">
                <span class="location-rule__line absolute inset-y-0 left-0 w-0"></span>
              </div>

              <div class="w-full">
                <!--
                  Flex with space-between rather than a grid: the image is
                  capped at 30vw, so in a `1fr` grid column it sat left inside
                  a wider track. Pushing it to the end lands its right edge on
                  the 80% container's.
                -->
                <div class="flex flex-col items-start gap-8 py-10 md:max-w-[80%] md:flex-row md:items-center md:justify-between">
                  <div class="min-w-0 max-w-[25rem]">
                    <h3 class="font-sans text-2xl font-semibold">{industry.title}</h3>
                    <p class="mt-4 leading-relaxed text-black/70">{industry.description}</p>
                  </div>

                  {industry.imageSrc && (
                    <!--
                      The image sits alone in this wrapper -- no tinted padding
                      box around it -- so the artwork's own ground is the only
                      colour, and the wrapper is what to animate the width of.
                    -->
                    <div class="location-industry-media shrink-0">
                      <div class="location-industry-media__wrapper">
                        <img
                          src={industry.imageSrc}
                          alt=""
                          loading="lazy"
                          class="location-industry-media__image"
                        />
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
      </div>
    </section>
  )}

  {location.processHeading && (
    <section class="bg-secondary-green py-16 text-white md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="font-sans text-3xl font-bold uppercase md:text-4xl">{location.processHeading}</h2>
        {location.processDescription && (
          <p class="mt-4 max-w-4xl leading-relaxed text-white/90">{location.processDescription}</p>
        )}

        <!--
          The steps are the same six for every office -- the process is how the
          company works, not something that varies by city -- so they come from
          content rather than the CMS. Only the heading and the paragraph above
          them are per-location, because those name the city.
        -->
        <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {locationProcess.map((step) => (
            <li class="rounded-2xl bg-white p-8 text-black">
              <p class="text-[1.25rem] font-semibold text-black/40">Step {step.number}</p>
              <h3 class="mt-1 font-sans text-[1.5rem] font-semibold">{step.title}</h3>
              <p class="mt-6 leading-relaxed text-black/70">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {location.serviceAreaHeading && location.serviceAreaDescription && (
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 md:grid-cols-2 md:gap-16">
        <div class="min-w-0">
          <h2 class="font-display text-3xl leading-tight md:text-4xl">{location.serviceAreaHeading}</h2>
          <div class="cs-prose mt-6 text-black/70" set:html={location.serviceAreaDescription} />
          <a
            href="#contact-form"
            class="mt-8 inline-block rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green"
          >
            Book a free call
          </a>
        </div>
        <img
          src="/images/Locations/service-area.png"
          alt=""
          loading="lazy"
          class="w-full rounded-[2rem] object-contain"
        />
      </div>
    </section>
  )}

  <FAQ content={faq} />

  {location.whyChooseUsHeading && (
    <section class="bg-secondary-green py-16 text-white md:py-20">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="font-sans text-3xl font-bold uppercase md:text-4xl">{location.whyChooseUsHeading}</h2>
        {location.whyChooseUsDescription && (
          <p class="mt-6 leading-relaxed text-white/90">{location.whyChooseUsDescription}</p>
        )}
        <a
          href="#contact-form"
          class="mt-10 inline-block rounded-md border border-white px-8 py-4 text-sm font-semibold text-white transition hover:bg-white hover:text-secondary-green"
        >
          Schedule call
        </a>
      </div>
    </section>
  )}

  {(location.contactHeading || location.contactDescription) && (
    <section class="bg-secondary py-16 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 px-6 md:grid-cols-2 md:gap-16">
        {location.contactHeading && (
          <h2 class="font-sans text-3xl font-bold uppercase md:text-4xl">{location.contactHeading}</h2>
        )}
        {location.contactDescription && (
          <div class="cs-prose text-black/70" set:html={location.contactDescription} />
        )}
      </div>
    </section>
  )}

  {hasTechnologies && (
    <section class="bg-secondary py-16 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-8 px-6 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-16">
        <!--
          Sticky so the heading stays put while the stack scrolls past it,
          which is what the original does. `self-start` for the same reason as
          the hero form: a stretched grid item has nothing to slide against.
        -->
        <h2 class="font-sans text-3xl font-bold uppercase md:sticky md:top-24 md:self-start md:text-4xl">
          {location.technologiesHeading}
        </h2>

        {location.techStack ? (
          <div class="cs-prose cs-prose--tech text-black/70" set:html={location.techStack} />
        ) : (
          <dl class="flex flex-col gap-6">
            {technologies.map((group) => (
              <div>
                <dt class="font-sans text-lg font-semibold text-black">{group.title}</dt>
                <dd class="mt-1 text-black/70">{group.technologies}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  )}

  {location.pricingHeading && location.pricingTable && (
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 md:grid-cols-2 md:gap-16">
        <div class="min-w-0">
          <h2 class="font-sans text-3xl font-bold uppercase md:text-4xl">{location.pricingHeading}</h2>
          <div class="cs-prose mt-8 text-black/70" set:html={location.pricingTable} />
        </div>
        <img
          src="/images/Locations/pricing.webp"
          alt=""
          loading="lazy"
          class="w-full rounded-[2rem] object-contain"
        />
      </div>
    </section>
  )}

  <Stats content={home.stats} />

  <Badges content={home.badges} />

  {mapSrc && (
    <section class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <h2 class="font-display text-3xl leading-tight md:text-4xl">Our office</h2>
      <address class="mt-4 not-italic text-black/70">{location.address}</address>
      <div class="mt-8 overflow-hidden rounded-2xl">
        <iframe
          src={mapSrc}
          title={`Map of the Synergy Labs office in ${location.city}`}
          width="100%"
          height="400"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  )}

</Layout>

<style>
  /* The rules draw themselves in when their row arrives. Width rather than a
     transform so the line grows from a hairline instead of being squashed and
     stretched, and `will-change` keeps it on its own layer for the duration.

     No-JS and reduced-motion both land on a fully drawn rule: the observer
     below never runs without JS, so the fallback has to be the finished state,
     not the empty one. */
  .location-rule {
    /* 2px so the draw actually reads; a 1px hairline at 10% black was doing
       the animation entirely below the threshold of noticing. */
    height: 2px;
  }

  .location-rule__line {
    background-color: rgb(0 0 0 / 0.25);
    transition: width 1800ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: width;
  }

  .location-rule--drawn .location-rule__line {
    width: 100%;
  }

  /* The image block joins the same reveal: the rule draws left to right, then
     the artwork beside it opens out from a 10vw sliver to its full width while
     the image inside settles from 1.1 to 1.

     Width is owned here rather than by Tailwind utilities because it is the
     animated property and needs a concrete target on both sides of the
     breakpoint -- `max-width` would have clamped the transition partway and
     left a dead tail, and a `scaleX` would have stretched the image instead of
     revealing more of it. --media-width is that target: the full column on a
     phone, the 30vw cap the row was already using from md up.

     The 120ms delay is the sequencing: the rule is already moving before the
     block starts to open. */
  /* Container. Always at its final width, so the row's layout never moves and
     the flex `justify-between` keeps its right edge on the 80% container's.
     Animating THIS was the bug: with the block pinned right, growing its width
     made it open right-to-left out of the corner. `container-type` is what
     gives the image below a width to size against that does not follow the
     wrapper -- without it the image would squeeze as the curtain opened
     instead of staying put underneath it. */
  .location-industry-media {
    --media-width: 100%;
    container-type: inline-size;
    width: var(--media-width);
  }

  @media (min-width: 768px) {
    .location-industry-media {
      --media-width: 30vw;
    }
  }

  /* The curtain: it starts as a sliver at the container's left edge and opens
     rightwards to fill it. */
  .location-industry-media__wrapper {
    border-radius: 2rem;
    max-width: 100cqw;
    overflow: hidden;
    transition: width 1200ms cubic-bezier(0.16, 1, 0.3, 1) 120ms;
    width: 10vw;
    will-change: width;
  }

  .location-industry-media--revealed .location-industry-media__wrapper {
    width: 100cqw;
  }

  /* Held at the container's full width while the curtain moves over it, so the
     reveal shows more of a still image rather than an unsquashing one.
     `max-width: none` is needed to beat the `img { max-width: 100% }` in
     Tailwind's preflight, which would otherwise clamp it to the wrapper and
     reintroduce the squash. The scale settles from the left edge so the part
     already on screen does not drift while the rest arrives. */
  .location-industry-media__image {
    aspect-ratio: 3 / 2;
    display: block;
    max-width: none;
    object-fit: cover;
    transform: scale(1.1);
    transform-origin: left center;
    transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1) 120ms;
    width: 100cqw;
    will-change: transform;
  }

  .location-industry-media--revealed .location-industry-media__image {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .location-rule__line {
      width: 100%;
      transition: none;
    }

    .location-industry-media__wrapper {
      width: 100cqw;
      transition: none;
    }

    .location-industry-media__image {
      transform: none;
      transition: none;
    }
  }
</style>

<noscript>
  <!--
    !important is load-bearing here, not laziness. Astro scopes the component
    styles above to `.location-industry-media[data-astro-cid-...]`, which is
    specificity (0,2,0); a <noscript> block is not scoped, so the same selector
    written plainly is (0,1,0) and loses. Without JS these elements would then
    stay at their collapsed 10vw start forever. Raising specificity by hand
    would mean hard-coding a build-generated cid, which would silently rot.
  -->
  <style>
    .location-rule__line { width: 100% !important; }
    .location-industry-media__wrapper { width: 100cqw !important; }
    .location-industry-media__image { transform: none !important; }
  </style>
</noscript>

<script>
  // Reveal each rule and each industry image once, when that element itself
  // scrolls into view. `once` semantics -- unobserve on the first hit -- so
  // scrolling back up doesn't rewind either.
  //
  // The two are observed separately rather than as one row: the rule sits at
  // the top of its row and the image most of a screen below it, so triggering
  // the image off the rule would open it while it was still under the fold.
  const REVEALS = [
    { selector: ".location-rule", revealed: "location-rule--drawn" },
    { selector: ".location-industry-media", revealed: "location-industry-media--revealed" },
  ];

  const targets = REVEALS.flatMap(({ selector, revealed }) =>
    [...document.querySelectorAll<HTMLElement>(selector)].map((el) => ({ el, revealed }))
  );

  if (targets.length > 0) {
    if (!("IntersectionObserver" in window)) {
      // Older browsers get the finished state rather than an element stuck at
      // its collapsed start.
      targets.forEach(({ el, revealed }) => el.classList.add(revealed));
    } else {
      const revealedClass = new WeakMap<Element, string>(
        targets.map(({ el, revealed }) => [el, revealed] as const)
      );

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const revealed = revealedClass.get(entry.target);
            if (revealed) entry.target.classList.add(revealed);
            observer.unobserve(entry.target);
          }
        },
        // A little inset from the bottom, so each one starts as it clears the
        // fold rather than the instant its first pixel does.
        { rootMargin: "0px 0px -15% 0px" }
      );

      targets.forEach(({ el }) => observer.observe(el));
    }
  }
</script>

