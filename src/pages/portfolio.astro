---
import { breadcrumbs, collectionPage } from "../lib/structuredData";
import Layout from "../components/layout/Layout.astro";
import PortfolioGrid from "../components/sections/PortfolioGrid.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import { portfolioPage } from "../content/portfolio";
import { withExistingCaseStudies } from "../lib/sanity";

// Same as the homepage grid: only link projects that actually have a page.
const portfolioContent = {
  ...portfolioPage,
  items: await withExistingCaseStudies(portfolioPage.items),
};

const description =
  "Explore Synergy Labs' portfolio of mobile and web apps built for startups and enterprises — including Fanbase, Clapper, Clearcover and Joe & The Juice.";
---

<Layout
  title="Portfolio"
  description={description}
  jsonLd={[
    collectionPage({
      name: "Portfolio",
      description,
      path: "/portfolio",
      items: portfolioContent.items.map((item) => ({
        type: "CreativeWork",
        name: item.clientName,
        path: item.caseStudyHref,
        description: item.description,
        image: item.imageSrc,
      })),
    }),
    breadcrumbs([{ name: "Portfolio", path: "/portfolio" }]),
  ]}
>
  <section class="mx-auto max-w-3xl px-6 pt-20 text-center md:pt-28">
    <h1 class="font-display text-4xl leading-tight md:text-5xl">{portfolioPage.heading}</h1>
    <p class="mt-6 text-lg text-black/70">{portfolioPage.subheading}</p>
  </section>

  <PortfolioGrid content={portfolioContent} />

  <ContactSection />
</Layout>
