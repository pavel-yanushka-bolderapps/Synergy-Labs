---
// Social-proof strip: overlapping client photos, a row of stars, the rating
// label, and a quill mark. Sizes and colours mirror the live Webflow build
// (.stacked-list3_* / .home_about_rating-* / ._5-star-text): 2.5rem avatars
// with a 2px light-grey ring lapped by -0.5rem, 1.5rem stars in
// secondary-green, 16px bold label.
import type { RatingBadgeContent } from "../lib/types";

interface Props {
  content: RatingBadgeContent;
  class?: string;
}

const { content, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-4", className]}>
  <!-- pl-2 offsets the first item's negative margin so the group still
       starts flush with the heading above it. -->
  <div class="flex pl-2">
    {content.avatarSrcs.map((src) => (
      <img
        src={src}
        alt=""
        loading="lazy"
        class="-ml-2 h-10 w-10 rounded-full border-2 border-light-grey object-cover"
      />
    ))}
  </div>

  <div class="flex text-secondary-green" role="img" aria-label={content.label}>
    {Array.from({ length: content.starCount }).map(() => (
      <svg viewBox="0 0 18 17" class="mr-1 h-6 w-6" aria-hidden="true">
        <path
          d="M8.16379 0.551109C8.47316 -0.183704 9.52684 -0.183703 9.83621 0.551111L11.6621 4.88811C11.7926 5.19789 12.0875 5.40955 12.426 5.43636L17.1654 5.81173C17.9684 5.87533 18.294 6.86532 17.6822 7.38306L14.0713 10.4388C13.8134 10.6571 13.7007 10.9996 13.7795 11.3259L14.8827 15.8949C15.0696 16.669 14.2172 17.2809 13.5297 16.8661L9.47208 14.4176C9.18225 14.2427 8.81775 14.2427 8.52793 14.4176L4.47029 16.8661C3.7828 17.2809 2.93036 16.669 3.11727 15.8949L4.22048 11.3259C4.29928 10.9996 4.18664 10.6571 3.92873 10.4388L0.317756 7.38306C-0.294046 6.86532 0.0315611 5.87533 0.834562 5.81173L5.57402 5.43636C5.91255 5.40955 6.20744 5.19789 6.33786 4.88811L8.16379 0.551109Z"
          fill="currentColor"
        />
      </svg>
    ))}
  </div>

  <!-- The stars already announce the rating via aria-label, so the matching
       text is decoration for screen readers. -->
  <span class="text-base font-bold" aria-hidden="true">{content.label}</span>

  <svg viewBox="0 0 24 24" class="h-8 w-8" aria-hidden="true">
    <g
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
    >
      <path d="m4 20l10-10m0-5v5h5m-9-1v5h5m-9-1v5h5m-5-5l4-4l4-4" />
      <path d="M19 10c.638-.636 1-1.515 1-2.486A3.515 3.515 0 0 0 16.483 4c-.97 0-1.847.367-2.483 1m-3 13l4-4l4-4" />
    </g>
  </svg>
</div>
