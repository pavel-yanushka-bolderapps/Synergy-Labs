---
// The one-field email form used twice on the ambassador pages: once in the
// hero, once under "Questions?". Markup only -- the submit handler lives in
// AmbassadorProgram.astro and binds to every `[data-lead-form]` on the page,
// so two of these on one page share a single copy of the script.
//
// Deliberately id-free apart from the label association, because two
// instances co-exist: everything the script needs is found relative to the
// form element itself.
interface Props {
  /** Unique per instance -- only used to tie the visually hidden label to the input. */
  inputId: string;
  placeholder: string;
  submitLabel: string;
  /** Path recorded in the notification email. Validated server-side. */
  source: string;
  /** Classes for the wrapper, so the hero and the questions band can differ. */
  class?: string;
}

const { inputId, placeholder, submitLabel, source, class: className = "" } = Astro.props;

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";
// Same local-testing escape hatch the other forms use -- the widget, the
// client check and the server verification all read this one flag.
const recaptchaDisabled = import.meta.env.PUBLIC_DISABLE_RECAPTCHA === "true";
---

<div class={className}>
  <form data-lead-form data-source={source} class="flex flex-col gap-4" novalidate>
    <div class="flex flex-col gap-3 sm:flex-row">
      <div class="flex-1">
        <label for={inputId} class="sr-only">Your email</label>
        <input
          id={inputId}
          name="email"
          type="email"
          required
          placeholder={placeholder}
          autocomplete="email"
          class="w-full rounded-md border border-black/20 bg-white px-4 py-3.5 text-sm placeholder:text-black/40 focus:border-primary-green focus:outline-none"
        />
      </div>

      <button
        type="submit"
        class="cursor-pointer whitespace-nowrap rounded-md bg-secondary-green px-8 py-3.5 text-sm font-semibold text-white transition hover:bg-primary-green disabled:cursor-not-allowed disabled:opacity-60"
      >
        {submitLabel}
      </button>
    </div>

    <!-- Honeypot: hidden from real visitors and from screen readers, but a bot
         that fills every input trips it and /api/lead silently drops the
         submission. Same field name as the other two forms. -->
    <div class="hidden" aria-hidden="true">
      <label for={`${inputId}-website`}>Website</label>
      <input id={`${inputId}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {!recaptchaDisabled && (
      <div class="g-recaptcha" data-sitekey={recaptchaSiteKey}></div>
    )}

    <p data-lead-error class="hidden text-sm font-semibold text-red-600" role="alert"></p>
    <p data-lead-success class="hidden text-sm font-semibold text-secondary-green" role="status"></p>
  </form>

  <p class="mt-3 text-xs text-black/60">
    We care about your data in our
    {" "}
    <a href="/privacy-policy" class="text-secondary-green underline">Privacy Policy</a>.
  </p>
</div>
