---
// The contact form itself, lifted out of ContactSection.astro so the
// location pages can put it in their hero's sticky column without a second
// copy of the 200-line submit/validation script.
//
// The script addresses things by id, so there can only be one of these on a
// page. What collapses on success is the parent's business: this renders the
// card, and whoever uses it supplies the #contact-form-wrapper to hide and
// the #contact-success block to reveal. See ContactSection.astro.
interface Props {
  /** Classes for the card, so each caller can place it in its own layout. */
  class?: string;
  /**
   * Placeholder-only fields for tight spaces like the blog's sticky rail:
   * the labels stay in the markup for screen readers but are visually
   * hidden, and the placeholders say what each field is instead. The budget
   * select keeps its visible label -- a select has no placeholder to carry it.
   */
  compact?: boolean;
}

const {
  class: className = "overflow-hidden rounded-3xl bg-secondary p-5 shadow-xl md:p-8",
  compact = false,
} = Astro.props;

const labelClass = compact ? "sr-only" : "text-sm font-semibold";
const fieldGap = compact ? "" : "mt-2 ";
// border-black/50 and the placeholder grey clear the 3:1 and 4.5:1 contrast
// minimums on the #fafafa card -- the old /20 border and /40 placeholder did
// not, and in the compact form the placeholder is the only visible label.
const fieldClass =
  "w-full rounded-md border border-black/50 bg-secondary px-4 py-3 text-sm placeholder:text-[#6b6b6b] focus:border-primary-green focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-green/40 aria-[invalid=true]:border-red-600";
const errorClass = "mt-1.5 hidden text-xs font-semibold text-red-600";
const placeholders = compact
  ? {
      firstName: "First Name",
      lastName: "Last Name",
      email: "Your Email",
      phone: "Your Phone number",
      projectDetails: "Your Message",
    }
  : {
      firstName: "John",
      lastName: "Smith",
      email: "name@example.com",
      phone: "(201) 555-0123",
      projectDetails: "Short description of your project",
    };

import { recaptchaConfig } from "../lib/recaptcha";
const { disabled: recaptchaDisabled, siteKey: recaptchaSiteKey } = recaptchaConfig();
---

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.min.css" />

<div class={className}>
  <form id="contact-form" class:list={["flex flex-col", compact ? "gap-4" : "gap-6"]} novalidate>
    <div class:list={["grid grid-cols-2 gap-3", !compact && "sm:gap-6"]}>
      <div>
        <label for="firstName" class={labelClass}>First Name</label>
        <input
          id="firstName"
          autocomplete="given-name"
          aria-describedby="firstName-error"
          name="firstName"
          type="text"
          required
          placeholder={placeholders.firstName}
          class={`${fieldGap}${fieldClass}`}
        />
        <p id="firstName-error" class={errorClass} aria-live="polite"></p>
      </div>
      <div>
        <label for="lastName" class={labelClass}>Last Name</label>
        <input
          id="lastName"
          autocomplete="family-name"
          aria-describedby="lastName-error"
          name="lastName"
          type="text"
          required
          placeholder={placeholders.lastName}
          class={`${fieldGap}${fieldClass}`}
        />
        <p id="lastName-error" class={errorClass} aria-live="polite"></p>
      </div>
    </div>

    <div>
      <label for="email" class={labelClass}>Your Email</label>
      <input
        id="email"
        autocomplete="email"
        aria-describedby="email-error"
        name="email"
        type="email"
        required
        placeholder={placeholders.email}
        class={`${fieldGap}${fieldClass}`}
      />
      <p id="email-error" class={errorClass} aria-live="polite"></p>
    </div>

    <div class="phone-field">
      <label for="phone" class={labelClass}>Your Phone number</label>
      <input
        id="phone"
        autocomplete="tel"
        aria-describedby="phone-error"
        name="phone"
        type="tel"
        required
        data-fixed-placeholder={compact ? "" : undefined}
        placeholder={placeholders.phone}
        class={`${fieldGap}${fieldClass}`}
      />
      <p id="phone-error" class={errorClass} aria-live="polite"></p>
    </div>

    <div>
      <label for="projectDetails" class={labelClass}>What do you need help with?</label>
      <textarea
        id="projectDetails"
        aria-describedby="projectDetails-error"
        name="projectDetails"
        required
        rows={compact ? 2 : 3}
        placeholder={placeholders.projectDetails}
        class={`${fieldGap}resize-y ${fieldClass}`}
      ></textarea>
      <p id="projectDetails-error" class={errorClass} aria-live="polite"></p>
    </div>

    <div>
      <label for="budgetRange" class={compact ? "mb-1.5 block text-sm" : labelClass}>
        {compact ? "What is your budget range?" : "Budget Range"}
      </label>
      <select
        id="budgetRange"
        name="budgetRange"
        class={`${fieldGap}${fieldClass}`}
      >
        {/* The Webflow form's options, verbatim: the values reach the lead email and
            RevenueHero's router rules, which were built against them. */}
        <option value="Less than $30K">Less than $30K</option>
        <option value="$30K-$50K">$30K-$50K</option>
        <option value="$50K-$100K" selected>$50K-$100K</option>
        <option value="$100K-$250K">$100K-$250K</option>
        <option value="More than $250K">More than $250K</option>
      </select>
    </div>

    <!-- Honeypot: hidden from real visitors via CSS, invisible to
         screen readers via aria-hidden + tabindex -- but a bot that
         naively fills every input on the page will fill this one
         too, which the API route uses to silently drop the submission. -->
    <div class="hidden" aria-hidden="true">
      <label for="website">Website</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {!recaptchaDisabled && (
      <div>
        <div class="g-recaptcha" data-sitekey={recaptchaSiteKey}></div>
      </div>
    )}

    <p id="contact-form-error" role="alert" tabindex="-1" class="hidden text-sm font-semibold text-red-600"></p>

    <button
      id="contact-form-submit"
      type="submit"
      class="rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green disabled:cursor-not-allowed disabled:opacity-60"
    >
      Submit
    </button>

    <p class="text-xs text-black/70">
      By submitting this form you consent to be contacted by Synergy Labs, and acknowledge our
      {" "}
      <a href="/privacy-policy" class="text-secondary-green underline">Privacy Policy</a>.
    </p>
  </form>
</div>

<style>
  /* intl-tel-input renders its own wrapper (.iti) around the #phone input at
     runtime -- Astro's scoped styles can't reach an element the library
     injects after hydration, so this needs :global to stretch it to the
     same width as every other field. */
  :global(.phone-field .iti) {
    display: block;
    width: 100%;
  }
</style>

{!recaptchaDisabled && (
  <script src="https://www.google.com/recaptcha/api.js" async defer is:inline></script>
)}

<!--
  is:inline is load-bearing. Without it Astro treats this as a script to
  process and bundle, and a remote URL it cannot resolve is dropped from the
  output entirely -- which is what happened: `window.intlTelInput` was never
  defined, the `iti` guard below quietly fell through to `null`, and the phone
  field rendered as a plain text box with no flag, no country list and no
  validation. It failed silently on every page carrying this form.

  A classic (non-module, non-async) script runs before the deferred module
  below it, so the library is always in place by the time that module runs.
-->
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"
></script>

<!--
  RevenueHero: after a lead is accepted it opens the meeting scheduler, so the
  visitor can book the call there and then. Same router as the Webflow site.
  Webflow attached it with hero.schedule('#email-form'), which listens for a
  native form submit -- this form posts with fetch, so the submit handler
  below hands it the data through hero.submit() instead.
-->
<script is:inline src="https://assets.revenuehero.io/scheduler.min.js" defer></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", function () {
    if (window.RevenueHero) window.hero = new window.RevenueHero({ routerId: "4617" });
  });
</script>

<script>
  declare global {
    interface Window {
      grecaptcha?: {
        getResponse: (widgetId?: number) => string;
        reset: (widgetId?: number) => void;
      };
      intlTelInput?: (input: HTMLInputElement, options: Record<string, unknown>) => {
        isValidNumber: () => boolean;
        getValidationError: () => number;
        getNumber: (format?: number) => string;
        setNumber: (number: string) => void;
        promise: Promise<unknown[]>;
      };
      /** Published by the library's utils.js once it finishes loading. */
      /** RevenueHero scheduler, set up by the inline script above. */
      hero?: {
        submit: (data: Record<string, string>) => Promise<unknown>;
        dialog: { open: (session: unknown) => void };
      };
      intlTelInputUtils?: {
        numberFormat: { E164: number; INTERNATIONAL: number; NATIONAL: number };
      };
    }
  }

  // Selected as a <form>, not just by id: eleven pages once gave their
  // ContactSection the same id, getElementById returned the <section>, and
  // `new FormData(section)` threw on every submit -- the form looked fine and
  // sent nothing.
  const form = document.querySelector<HTMLFormElement>("form#contact-form");
  const formWrapper = document.getElementById("contact-form-wrapper");
  const successBlock = document.getElementById("contact-success");
  const submitButton = document.getElementById("contact-form-submit") as HTMLButtonElement | null;
  const errorMessage = document.getElementById("contact-form-error");

  /** Show or clear a field's message and keep aria-invalid in step with it. */
  function setFieldError(input: HTMLElement, errorEl: HTMLElement, message: string | null) {
    errorEl.textContent = message ?? "";
    errorEl.classList.toggle("hidden", !message);
    input.setAttribute("aria-invalid", String(Boolean(message)));
  }

  // --- Required text fields ----------------------------------------------------
  const REQUIRED_FIELDS: Array<[string, string]> = [
    ["firstName", "First name is required."],
    ["lastName", "Last name is required."],
    ["projectDetails", "Please tell us a little about your project."],
  ];

  function validateRequired(id: string, message: string, showEmptyError: boolean): boolean {
    const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    const errorEl = document.getElementById(`${id}-error`);
    if (!input || !errorEl) return true;
    if (input.value.trim()) {
      setFieldError(input, errorEl, null);
      return true;
    }
    if (showEmptyError) setFieldError(input, errorEl, message);
    return false;
  }

  for (const [id, message] of REQUIRED_FIELDS) {
    const input = document.getElementById(id);
    input?.addEventListener("input", () => validateRequired(id, message, false));
    input?.addEventListener("blur", () => validateRequired(id, message, true));
  }

  // --- Email validation ------------------------------------------------------
  const emailInput = document.getElementById("email") as HTMLInputElement | null;
  const emailError = document.getElementById("email-error");
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function validateEmail(showEmptyError: boolean): boolean {
    if (!emailInput || !emailError) return true;
    const value = emailInput.value.trim();

    if (!value) {
      if (showEmptyError) setFieldError(emailInput, emailError, "Email is required.");
      return false;
    }

    if (!EMAIL_PATTERN.test(value)) {
      setFieldError(emailInput, emailError, "Please enter a valid email address.");
      return false;
    }

    setFieldError(emailInput, emailError, null);
    return true;
  }

  emailInput?.addEventListener("input", () => validateEmail(false));
  emailInput?.addEventListener("blur", () => validateEmail(true));

  // --- Phone validation (intl-tel-input) --------------------------------------
  const phoneInput = document.getElementById("phone") as HTMLInputElement | null;
  const phoneError = document.getElementById("phone-error");
  const PHONE_ERROR_MESSAGES: Record<number, string> = {
    0: "Invalid phone number.",
    1: "Invalid country code.",
    2: "Number is too short.",
    3: "Number is too long.",
    4: "Invalid phone number.",
  };

  // Configured to match the Webflow widget this replaces, which ran with
  // `ms-code-phone-number="us,ca,gb"`: the flag and dial code sit inside the
  // field (not split into a separate prefix box), those three countries are
  // pinned to the top of the list, and the country starts from the visitor's
  // own.
  const iti = phoneInput && window.intlTelInput
    ? window.intlTelInput(phoneInput, {
        preferredCountries: ["us", "ca", "gb"],
        // Webflow's version geo-located with a jQuery JSONP call to ipinfo.io
        // and then called setCountry() afterwards, which overwrote the
        // country if the visitor had already picked one while the request was
        // in flight. initialCountry: "auto" is the library's own hook for
        // this and only applies the result if nothing has been chosen yet.
        initialCountry: "auto",
        geoIpLookup: (success: (countryCode: string) => void) => {
          // ipinfo.io's tokenless endpoint is rate limited and can fail or
          // hang, and the field must not be unusable when it does -- so this
          // always resolves, and falls back to US after two seconds.
          const done = (code: string) => success(code);
          const timer = setTimeout(() => done("us"), 2000);

          fetch("https://ipinfo.io/json")
            .then((res) => (res.ok ? res.json() : Promise.reject()))
            .then((data: { country?: string }) => {
              clearTimeout(timer);
              done(data.country || "us");
            })
            .catch(() => {
              clearTimeout(timer);
              done("us");
            });
        },
        // The compact form's placeholder names the field, so the library must
        // not swap it for an example number.
        autoPlaceholder: phoneInput.hasAttribute("data-fixed-placeholder") ? "off" : "aggressive",
        formatOnDisplay: true,
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
      })
    : null;

  function validatePhone(showEmptyError: boolean): boolean {
    if (!phoneInput || !phoneError) return true;
    const value = phoneInput.value.trim();

    // Required, as on the Webflow form -- the lead is routed to a call. While
    // typing, an emptied field just clears its message; leaving it empty or
    // submitting is what flags it.
    if (!value) {
      setFieldError(phoneInput, phoneError, showEmptyError ? "Phone number is required." : null);
      return false;
    }

    // Without utils.js (still loading, or blocked) isValidNumber() has
    // nothing to check against and fails every number -- let it through and
    // leave the shape check to the API route.
    if (!iti || !window.intlTelInputUtils) {
      setFieldError(phoneInput, phoneError, null);
      return true;
    }

    if (iti.isValidNumber()) {
      setFieldError(phoneInput, phoneError, null);
      return true;
    }

    const code = iti.getValidationError();
    setFieldError(phoneInput, phoneError, PHONE_ERROR_MESSAGES[code] ?? "Please enter a valid phone number.");
    return false;
  }

  phoneInput?.addEventListener("input", () => {
    // Block anything that obviously isn't part of a phone number as the user types.
    phoneInput.value = phoneInput.value.replace(/[^0-9+()\s-]/g, "");
    validatePhone(false);
  });
  phoneInput?.addEventListener("keypress", (event) => {
    if (!/[0-9+()\s-]/.test(event.key)) {
      event.preventDefault();
    }
  });
  /**
   * Rewrite what is in the box into the national format for the selected
   * country -- "(201) 555-0123" rather than "2015550123".
   *
   * Webflow did this on every keyup. That reformats the value under the
   * caret, so editing a digit in the middle of a number threw the cursor to
   * the end on the next keystroke. Doing it when the field is left, and when
   * the country changes, reaches the same formatted result without fighting
   * the person typing.
   */
  function formatPhoneNational() {
    if (!phoneInput || !iti) return;
    if (!phoneInput.value.trim()) return;
    if (!iti.isValidNumber()) return; // Half-typed numbers are left alone.

    const national = window.intlTelInputUtils
      ? iti.getNumber(window.intlTelInputUtils.numberFormat.NATIONAL)
      : "";
    if (national) phoneInput.value = national;
  }

  /**
   * Point the country picker at the dial code in the box. intl-tel-input only
   * does this on keyup, so a number that arrives without keystrokes -- pasted,
   * or filled in by the browser's autofill -- kept the old country: "+48 512
   * 345 678" was checked as a US number and rejected as "too short".
   */
  function syncCountryFromNumber() {
    const value = phoneInput?.value.trim();
    if (iti && value?.startsWith("+")) iti.setNumber(value);
  }

  phoneInput?.addEventListener("blur", () => {
    syncCountryFromNumber();
    formatPhoneNational();
    validatePhone(true);
  });
  phoneInput?.addEventListener("countrychange", () => {
    formatPhoneNational();
    validatePhone(false);
  });

  // Timestamp when the form became interactive -- sent along with the
  // submission so the API route can reject anything submitted faster than a
  // human could plausibly fill it out (see the honeypot/timing check in
  // src/pages/api/contact.ts).
  const formLoadedAt = Date.now();

  function showError(message: string) {
    if (!errorMessage) return;
    errorMessage.textContent = message;
    errorMessage.classList.remove("hidden");
    // role="alert" announces it; focus keeps keyboard users next to it rather
    // than stranded on the disabled-then-re-enabled button.
    errorMessage.focus();
  }

  function clearError() {
    errorMessage?.classList.add("hidden");
  }

  /**
   * Hand the accepted lead to RevenueHero to open its booking dialog. The keys
   * are the Webflow form's field names, which router 4617's rules were built
   * against. Never allowed to break the submission: the lead is already sent.
   */
  function openScheduler(payload: Record<string, unknown>) {
    const hero = window.hero;
    if (!hero) return;
    const budgetSelect = document.getElementById("budgetRange") as HTMLSelectElement | null;
    hero
      .submit({
        "First-Name": String(payload.firstName ?? ""),
        "Last-Name": String(payload.lastName ?? ""),
        Email: String(payload.email ?? ""),
        Phone: String(payload.phone ?? ""),
        Message: String(payload.projectDetails ?? ""),
        Budget: budgetSelect?.selectedOptions[0]?.text ?? "",
      })
      .then((session) => {
        if (session) hero.dialog.open(session);
      })
      .catch((err) => console.error("[revenuehero]", err));
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearError();

    // Run every check (not just up to the first failure) so all the messages
    // show at once, then put focus on the first field that needs fixing.
    const requiredOk = REQUIRED_FIELDS.map(([id, message]) => validateRequired(id, message, true));
    const emailOk = validateEmail(true);
    syncCountryFromNumber();
    const phoneOk = validatePhone(true);
    if (!requiredOk.every(Boolean) || !emailOk || !phoneOk) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    // Whether a widget was actually rendered, rather than re-deriving it from
    // the env var: a build with no site key renders no widget while
    // PUBLIC_DISABLE_RECAPTCHA is still unset, and gating on the variable then
    // demanded a token from a checkbox that is not on the page -- the form
    // could never be submitted. The element is the only honest signal.
    const recaptchaWidget = document.querySelector(".g-recaptcha");
    const recaptchaToken = recaptchaWidget ? window.grecaptcha?.getResponse() ?? "" : "";
    if (recaptchaWidget && !recaptchaToken) {
      showError("Please complete the reCAPTCHA check before submitting.");
      return;
    }

    const data = new FormData(form);
    // Normalise on the way out, as Webflow did, so the number in the
    // notification email is the same shape however the visitor typed it:
    // international ("+1 201 555 0123"), which stays readable to whoever picks
    // the lead up. Falls back to E.164 if utils.js has not loaded, and to the
    // raw value if the library is missing altogether.
    const phoneValue = phoneInput?.value.trim()
      ? (window.intlTelInputUtils
          ? iti?.getNumber(window.intlTelInputUtils.numberFormat.INTERNATIONAL)
          : iti?.getNumber()) || phoneInput.value.trim()
      : "";
    const payload = {
      firstName: String(data.get("firstName") ?? ""),
      lastName: String(data.get("lastName") ?? ""),
      email: String(data.get("email") ?? ""),
      phone: phoneValue,
      projectDetails: String(data.get("projectDetails") ?? ""),
      budgetRange: String(data.get("budgetRange") ?? ""),
      website: String(data.get("website") ?? ""),
      recaptchaToken,
      formLoadedAt,
      // The page the form was filled in on, query string included so UTM and
      // ad-click parameters reach the lead email -- what Webflow recorded as
      // each submission's page. This form sits on hundreds of pages.
      pageUrl: window.location.href,
    };

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
    }

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (!res.ok || !result.success) {
        throw new Error(result.error || "Something went wrong. Please try again.");
      }

      openScheduler(payload);

      // Success: swap the form card out for the success card.
      formWrapper?.classList.add("hidden");
      successBlock?.classList.remove("hidden");
      successBlock?.classList.add("flex");
      successBlock?.scrollIntoView({ behavior: "smooth", block: "start" });
      // The form the user was in is gone; move focus to the confirmation so a
      // screen reader announces it.
      if (successBlock) {
        successBlock.setAttribute("tabindex", "-1");
        successBlock.focus({ preventScroll: true });
      }
    } catch (err) {
      showError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
      window.grecaptcha?.reset();
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Submit";
      }
    }
  });
</script>
