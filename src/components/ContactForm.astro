---
// The contact form itself, lifted out of ContactSection.astro so the
// location pages can put it in their hero's sticky column without a second
// copy of the 200-line submit/validation script.
//
// The script addresses things by id, so there can only be one of these on a
// page. What collapses on success is the parent's business: this renders the
// card, and whoever uses it supplies the #contact-form-wrapper to hide and
// the #contact-success block to reveal. See ContactSection.astro.
interface Props {
  /** Classes for the card, so each caller can place it in its own layout. */
  class?: string;
}

const { class: className = "overflow-hidden rounded-3xl bg-secondary p-10 shadow-xl md:p-8" } = Astro.props;

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";
// Temporary local-testing escape hatch: set PUBLIC_DISABLE_RECAPTCHA=true in
// .env to skip reCAPTCHA entirely (widget, client check, and server
// verification all respect this same flag -- see src/pages/api/contact.ts).
const recaptchaDisabled = import.meta.env.PUBLIC_DISABLE_RECAPTCHA === "true";
---

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.min.css" />

<div class={className}>
  <form id="contact-form" class="flex flex-col gap-6" novalidate>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <label for="firstName" class="text-sm font-semibold">First Name</label>
        <input
          id="firstName"
          name="firstName"
          type="text"
          required
          placeholder="John"
          class="mt-2 w-full rounded-md border border-black/20 bg-white px-4 py-3 text-sm placeholder:text-black/40 focus:border-primary-green focus:outline-none"
        />
      </div>
      <div>
        <label for="lastName" class="text-sm font-semibold">Last Name</label>
        <input
          id="lastName"
          name="lastName"
          type="text"
          required
          placeholder="Smith"
          class="mt-2 w-full rounded-md border border-black/20 bg-white px-4 py-3 text-sm placeholder:text-black/40 focus:border-primary-green focus:outline-none"
        />
      </div>
    </div>

    <div>
      <label for="email" class="text-sm font-semibold">Your Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="name@example.com"
        class="mt-2 w-full rounded-md border border-black/20 bg-white px-4 py-3 text-sm placeholder:text-black/40 focus:border-primary-green focus:outline-none"
      />
      <p id="email-error" class="mt-1.5 hidden text-xs font-semibold text-red-600"></p>
    </div>

    <div class="phone-field">
      <label for="phone" class="text-sm font-semibold">Your Phone number</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        placeholder="(201) 555-0123"
        class="mt-2 w-full rounded-md border border-black/20 bg-white px-4 py-3 text-sm placeholder:text-black/40 focus:border-primary-green focus:outline-none"
      />
      <p id="phone-error" class="mt-1.5 hidden text-xs font-semibold text-red-600"></p>
    </div>

    <div>
      <label for="projectDetails" class="text-sm font-semibold">What do you need help with?</label>
      <textarea
        id="projectDetails"
        name="projectDetails"
        required
        rows={3}
        placeholder="Short description of your project"
        class="mt-2 w-full resize-y rounded-md border border-black/20 bg-white px-4 py-3 text-sm placeholder:text-black/40 focus:border-primary-green focus:outline-none"
      ></textarea>
    </div>

    <div>
      <label for="budgetRange" class="text-sm font-semibold">Budget Range</label>
      <select
        id="budgetRange"
        name="budgetRange"
        class="mt-2 w-full rounded-md border border-black/20 bg-white px-4 py-3 text-sm focus:border-primary-green focus:outline-none"
      >
        <option value="">Select a range</option>
        <option value="<$25K">Less than $25K</option>
        <option value="$25K-$50K">$25K-$50K</option>
        <option value="$50K-$100K" selected>$50K-$100K</option>
        <option value="$100K+">$100K+</option>
      </select>
    </div>

    <!-- Honeypot: hidden from real visitors via CSS, invisible to
         screen readers via aria-hidden + tabindex -- but a bot that
         naively fills every input on the page will fill this one
         too, which the API route uses to silently drop the submission. -->
    <div class="hidden" aria-hidden="true">
      <label for="website">Website</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {!recaptchaDisabled && (
      <div>
        <div class="g-recaptcha" data-sitekey={recaptchaSiteKey}></div>
      </div>
    )}

    <p id="contact-form-error" class="hidden text-sm font-semibold text-red-600"></p>

    <button
      id="contact-form-submit"
      type="submit"
      class="rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green disabled:cursor-not-allowed disabled:opacity-60"
    >
      Submit
    </button>

    <p class="text-xs text-black/60">
      By submitting this form you consent to be contacted by Synergy Labs, and acknowledge our
      {" "}
      <a href="/privacy-policy" class="text-secondary-green underline">Privacy Policy</a>.
    </p>
  </form>
</div>
  </div>
<style>
  /* intl-tel-input renders its own wrapper (.iti) around the #phone input at
     runtime -- Astro's scoped styles can't reach an element the library
     injects after hydration, so this needs :global to stretch it to the
     same width as every other field. */
  :global(.phone-field .iti) {
    display: block;
    width: 100%;
  }
</style>

{!recaptchaDisabled && (
  <script src="https://www.google.com/recaptcha/api.js" async defer is:inline></script>
)}

<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<script>
  declare global {
    interface Window {
      grecaptcha?: {
        getResponse: (widgetId?: number) => string;
        reset: (widgetId?: number) => void;
      };
      intlTelInput?: (input: HTMLInputElement, options: Record<string, unknown>) => {
        isValidNumber: () => boolean;
        getValidationError: () => number;
        getNumber: () => string;
      };
    }
  }

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const formWrapper = document.getElementById("contact-form-wrapper");
  const successBlock = document.getElementById("contact-success");
  const submitButton = document.getElementById("contact-form-submit") as HTMLButtonElement | null;
  const errorMessage = document.getElementById("contact-form-error");

  // --- Email validation ------------------------------------------------------
  const emailInput = document.getElementById("email") as HTMLInputElement | null;
  const emailError = document.getElementById("email-error");
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function validateEmail(showEmptyError: boolean): boolean {
    if (!emailInput || !emailError) return true;
    const value = emailInput.value.trim();

    if (!value) {
      emailError.classList.toggle("hidden", !showEmptyError);
      if (showEmptyError) emailError.textContent = "Email is required.";
      return false;
    }

    if (!EMAIL_PATTERN.test(value)) {
      emailError.textContent = "Please enter a valid email address.";
      emailError.classList.remove("hidden");
      return false;
    }

    emailError.classList.add("hidden");
    return true;
  }

  emailInput?.addEventListener("input", () => validateEmail(false));
  emailInput?.addEventListener("blur", () => validateEmail(true));

  // --- Phone validation (intl-tel-input) --------------------------------------
  const phoneInput = document.getElementById("phone") as HTMLInputElement | null;
  const phoneError = document.getElementById("phone-error");
  const PHONE_ERROR_MESSAGES: Record<number, string> = {
    0: "Invalid phone number.",
    1: "Invalid country code.",
    2: "Number is too short.",
    3: "Number is too long.",
    4: "Invalid phone number.",
  };

  const iti = phoneInput && window.intlTelInput
    ? window.intlTelInput(phoneInput, {
        preferredCountries: ["us", "gb", "ae"],
        separateDialCode: true,
        autoPlaceholder: "aggressive",
        formatOnDisplay: true,
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
      })
    : null;

  function validatePhone(): boolean {
    if (!phoneInput || !phoneError) return true;
    const value = phoneInput.value.trim();

    // Phone is optional -- an empty field is valid, just not filled in.
    if (!value) {
      phoneError.classList.add("hidden");
      return true;
    }

    if (!iti) return true;

    if (iti.isValidNumber()) {
      phoneError.classList.add("hidden");
      return true;
    }

    const code = iti.getValidationError();
    phoneError.textContent = PHONE_ERROR_MESSAGES[code] ?? "Please enter a valid phone number.";
    phoneError.classList.remove("hidden");
    return false;
  }

  phoneInput?.addEventListener("input", () => {
    // Block anything that obviously isn't part of a phone number as the user types.
    phoneInput.value = phoneInput.value.replace(/[^0-9+()\s-]/g, "");
    validatePhone();
  });
  phoneInput?.addEventListener("keypress", (event) => {
    if (!/[0-9+()\s-]/.test(event.key)) {
      event.preventDefault();
    }
  });
  phoneInput?.addEventListener("blur", validatePhone);
  phoneInput?.addEventListener("countrychange", validatePhone);

  // Timestamp when the form became interactive -- sent along with the
  // submission so the API route can reject anything submitted faster than a
  // human could plausibly fill it out (see the honeypot/timing check in
  // src/pages/api/contact.ts).
  const formLoadedAt = Date.now();

  function showError(message: string) {
    if (!errorMessage) return;
    errorMessage.textContent = message;
    errorMessage.classList.remove("hidden");
  }

  function clearError() {
    errorMessage?.classList.add("hidden");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearError();

    const emailOk = validateEmail(true);
    const phoneOk = validatePhone();
    if (!emailOk) {
      emailInput?.focus();
      return;
    }
    if (!phoneOk) {
      phoneInput?.focus();
      return;
    }

    const recaptchaDisabled = import.meta.env.PUBLIC_DISABLE_RECAPTCHA === "true";
    const recaptchaToken = recaptchaDisabled ? "" : window.grecaptcha?.getResponse() ?? "";
    if (!recaptchaDisabled && !recaptchaToken) {
      showError("Please complete the reCAPTCHA check before submitting.");
      return;
    }

    const data = new FormData(form);
    // Send the phone number in normalized international (E.164) format when
    // one was entered, so the same number is stored/emailed consistently
    // regardless of how the visitor typed it.
    const phoneValue = phoneInput?.value.trim() ? iti?.getNumber() ?? phoneInput.value.trim() : "";
    const payload = {
      firstName: String(data.get("firstName") ?? ""),
      lastName: String(data.get("lastName") ?? ""),
      email: String(data.get("email") ?? ""),
      phone: phoneValue,
      projectDetails: String(data.get("projectDetails") ?? ""),
      budgetRange: String(data.get("budgetRange") ?? ""),
      website: String(data.get("website") ?? ""),
      recaptchaToken,
      formLoadedAt,
    };

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
    }

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (!res.ok || !result.success) {
        throw new Error(result.error || "Something went wrong. Please try again.");
      }

      // Success: swap the form card out for the success card.
      formWrapper?.classList.add("hidden");
      successBlock?.classList.remove("hidden");
      successBlock?.classList.add("flex");
      successBlock?.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (err) {
      showError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
      window.grecaptcha?.reset();
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Submit";
      }
    }
  });
</script>
