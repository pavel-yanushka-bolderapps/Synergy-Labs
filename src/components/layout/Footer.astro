---
import type { SiteFooter } from "../../lib/types";

interface Props {
  footer: SiteFooter;
}

const { footer } = Astro.props;
---

<footer class="bg-secondary-green text-white relative">
  <img
    src="/images/Hero-Bg.svg"
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
  />
  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      <div>
        <img src={footer.logoSrc} alt="Synergy Labs" class="h-8 w-auto brightness-0 invert" />
      </div>

      <nav class="flex flex-col gap-3">
        {footer.links.map((link) => (
          <a href={link.href} class="flex w-fit items-center gap-1.5 text-sm text-white/80 transition hover:text-white">
            {link.label}
            {link.badge && (
              <span class="rounded-full bg-white/20 px-1.5 py-0.5 text-[10px] font-semibold uppercase leading-none text-white">
                {link.badge}
              </span>
            )}
          </a>
        ))}
      </nav>

      <div class="flex flex-col gap-3 text-sm text-white/80">
        <span class="text-white">Contacts</span>
        <a href={`mailto:${footer.email}`} class="hover:text-white">{footer.email}</a>
        <a href={`tel:${footer.phone.replace(/[^+\d]/g, "")}`} class="hover:text-white">{footer.phone}</a>
        <span>{footer.address}</span>

        <span class="mt-6 border-b border-white/10 pb-3 text-white">Social Links</span>
        <div class="flex items-center gap-2">
          {footer.socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Synergy Labs on ${link.label}`}
              class="opacity-80 transition hover:opacity-100"
            >
              <img src={link.iconSrc} alt="" loading="lazy" class="h-8 w-8 object-contain" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-xs text-white/60 md:flex-row md:items-center">
      <span>{footer.copyright}</span>
      <div class="flex gap-6">
        {footer.legalLinks.map((link) => (
          <a href={link.href} class="hover:text-white">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
