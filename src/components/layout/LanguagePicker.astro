---
// The floating language picker in the bottom-right corner, where Weglot's sat
// on the Webflow site. A <details> dropdown, so it needs no script and works
// the same on the translated copies.
//
// It is rendered once, on the English page. The translation middleware leaves
// it alone (notranslate, and links carrying `hreflang` are never rewritten),
// then marks the visitor's language as the current one -- see
// markCurrentLanguage in src/lib/i18n/translatePage.ts.
import { LIVE_LANGUAGES, localizedPath } from "../../lib/i18n/languages";

const path = Astro.url.pathname;
const options = [
  { code: "en", native: "English", href: path },
  ...LIVE_LANGUAGES.map((l) => ({ code: l.code, native: l.native, href: localizedPath(path, l.code) })),
];
---

{LIVE_LANGUAGES.length > 0 && (
<details
  class="lang-picker notranslate group fixed bottom-4 right-4 z-50 text-sm"
  translate="no"
  data-lang-picker
>
  <summary
    class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2.5 font-semibold text-black shadow-lg transition hover:border-secondary-green [&::-webkit-details-marker]:hidden"
    aria-label="Change language"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-secondary-green" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10" />
      <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />
    </svg>
    <span data-lang-current>EN</span>
    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5 transition group-open:rotate-180" fill="currentColor">
      <path d="M5.3 12.7a1 1 0 0 0 1.4 0L10 9.4l3.3 3.3a1 1 0 0 0 1.4-1.4l-4-4a1 1 0 0 0-1.4 0l-4 4a1 1 0 0 0 0 1.4Z" />
    </svg>
  </summary>
  <ul class="absolute bottom-full right-0 mb-2 w-44 overflow-hidden rounded-xl border border-black/10 bg-white py-1 shadow-xl">
    {options.map((o) => (
      <li>
        <a
          href={o.href}
          hreflang={o.code}
          lang={o.code}
          data-lang={o.code}
          aria-current={o.code === "en" ? "true" : undefined}
          class="flex items-center justify-between px-4 py-2 text-black/80 transition hover:bg-green-50 hover:text-black aria-[current=true]:font-semibold aria-[current=true]:text-secondary-green"
        >
          <span>{o.native}</span>
          <span class="text-xs uppercase text-black/40">{o.code}</span>
        </a>
      </li>
    ))}
  </ul>
</details>
)}

<script>
  // Close the dropdown on a click outside it or on Escape, like a real menu.
  for (const picker of document.querySelectorAll<HTMLDetailsElement>("[data-lang-picker]")) {
    document.addEventListener("click", (e) => {
      if (picker.open && !picker.contains(e.target as Node)) picker.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && picker.open) {
        picker.open = false;
        picker.querySelector("summary")?.focus();
      }
    });
  }
</script>
