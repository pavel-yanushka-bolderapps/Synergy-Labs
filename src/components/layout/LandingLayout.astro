---
// The shell for the /top-* landing pages. Deliberately not Layout.astro: these
// are conversion pages that Clutch and paid traffic land on, and the Webflow
// originals carried no site nav at all -- logo, phone, and one CTA. Dropping
// a full nav onto them would give the visitor nine ways to leave before they
// reach the form.
//
// It still owns the same head that Layout.astro does, because the SEO tags are
// not optional on the pages most likely to be a first impression.
import Analytics from "./Analytics.astro";
import { nav } from "../../content/nav";
import { footer } from "../../content/footer";
import { previewEnabled } from "../../lib/loadQuery";
import { canonicalUrl, assetUrl } from "../../lib/seo";
import { stegaClean } from "@sanity/client/stega";
import "../../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Slug of the page that should rank, when this one duplicates it. */
  canonical?: string;
  /** "en" or "ar" -- one of these pages is Arabic. */
  locale?: string;
}

const { title, description, canonical, locale = "en" } = Astro.props;

// Same as Layout.astro: nothing in <head> keeps its click-to-edit markers.
const metaTitle = stegaClean(title) as string;
const metaDescription = stegaClean(description) as string;

const pageUrl = canonicalUrl(stegaClean(canonical ?? Astro.url.pathname) as string, Astro.site);
const ogImageUrl = assetUrl("/images/og-default.webp", Astro.site);
const telHref = `tel:${nav.phone.replace(/[^+\d]/g, "")}`;
// Arabic needs the whole document flipped, not just the text aligned.
const dir = locale === "ar" ? "rtl" : "ltr";

// The Studio's click-to-edit overlay, pulled in only when preview mode is
// actually on.
//
// This was a static `import { VisualEditing } from "@sanity/astro/visual-editing"`,
// which put the package -- and with it 170KB of Sanity Studio CSS -- into the
// stylesheet of all 419 public pages. Tailwind v4 emits everything inside
// `@layer`, the Studio's CSS is unlayered, and unlayered rules beat layered
// ones at any specificity. So the Studio silently outranked every Tailwind
// utility on the site: the nav logo lost `h-8` and rendered at full size,
// every section lost `mx-auto max-w-7xl px-6` and ran edge to edge. Fonts and
// colours survived because they come from `@theme` custom properties and the
// element rules in global.css, which is why it looked like a partial failure
// rather than a missing stylesheet.
//
// It only ever showed in built output: `astro dev` serves CSS unbundled, so
// the Studio's never reached a public page locally.
//
// `previewEnabled` is a build-time constant, so a production build takes the
// null branch and the import is never evaluated. Awaiting it here is what
// keeps its CSS out of the page's <link> tags -- a dynamic import lands in
// its own chunk instead of the page's stylesheet.
// The condition must be `import.meta.env.X` read directly here, not the
// `previewEnabled` constant from loadQuery.ts. Vite inlines `import.meta.env`
// as a literal at build time, so this whole branch folds to dead code and
// Rollup drops the import -- and its stylesheet -- with it. Going through
// `previewEnabled` does not fold, because it is computed in another module,
// and the Studio CSS ships anyway. Both were measured: literal condition ->
// 0 of 419 pages carry it, imported constant -> all 419 do.
// Do not try to make this self-defending by adding
// `&& import.meta.env.SANITY_API_READ_TOKEN`. Vite does not inline private
// env vars as literals, so the condition stops folding and all 419 pages get
// the Studio CSS again -- measured. Only the PUBLIC_ flag can be folded,
// which means a build is only as safe as the environment it runs in: setting
// PUBLIC_SANITY_VISUAL_EDITING_ENABLED in a deployment breaks that site's
// styling, and nothing in this file can prevent it. audit-seo.mjs fails on it
// instead.
const VisualEditing = __VISUAL_EDITING_ENABLED__
  ? (await import("@sanity/astro/visual-editing")).VisualEditing
  : null;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />

    <link rel="canonical" href={pageUrl} />

    <meta property="og:site_name" content="Synergy Labs" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Analytics />
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-secondary-green focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>

    <header class="border-b border-black/10 bg-secondary">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4">
        <a href="/" aria-label="Synergy Labs home">
          <img src={nav.logoSrc} alt={nav.logoAlt} class="h-8 w-auto md:h-11" />
        </a>

        <div class="flex items-center gap-4 md:gap-6">
          <a href={telHref} class="whitespace-nowrap text-xs font-medium text-black/80 md:text-sm">
            {nav.phone}
          </a>
          <a
            href="#contact"
            class="whitespace-nowrap rounded-md bg-secondary-green px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-green md:px-5"
          >
            {nav.ctaButton.label}
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-black/10 bg-secondary py-10">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-6 text-center text-xs text-black/60">
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          <a href={`mailto:${footer.email}`} class="hover:text-black">{footer.email}</a>
          <a href={telHref} class="hover:text-black">{footer.phone}</a>
          <span>{footer.address}</span>
        </div>
        <span>{footer.copyright}</span>
      </div>
    </footer>

    {VisualEditing && previewEnabled && <VisualEditing enabled />}
  </body>
</html>
