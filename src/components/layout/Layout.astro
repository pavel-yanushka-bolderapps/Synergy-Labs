---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { VisualEditing } from "@sanity/astro/visual-editing";
import { nav } from "../../content/nav";
import { footer } from "../../content/footer";
import { previewEnabled } from "../../lib/loadQuery";
import "../../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Synergy Labs — AI + Mobile App Development Agency" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen">
    <Header nav={nav} />
    <main>
      <slot />
    </main>
    <Footer footer={footer} />
    <!--
      Click-to-edit overlay for the Studio's "Preview" tab. Renders nothing
      unless queries are running in preview mode (see src/lib/loadQuery.ts),
      so this costs the public site nothing.
    -->
    <VisualEditing enabled={previewEnabled} />
    {previewEnabled && (
      <!--
        The overlay positions its click-to-edit boxes with absolutely
        positioned elements that can sit past the right edge of the page,
        which gives the document a horizontal scrollbar and makes every
        section look like it overflows. That is an artefact of preview mode
        only -- the overlay is not in the production build at all -- but it
        makes local layout checks read as broken, so clip it here.

        Deliberately scoped to preview mode: applying this to the public
        site would hide real overflow bugs instead of surfacing them.
      -->
      <style is:inline>
        html {
          overflow-x: clip;
        }
      </style>
    )}
  </body>
</html>
