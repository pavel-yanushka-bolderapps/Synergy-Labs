---
// Every third-party tag the Webflow site carried in its custom-code panels,
// ported to the Astro build. These are the same accounts and the same pixel
// ids the live site uses today, so the data is continuous across the cutover
// rather than starting again from zero.
//
// Rendered into <head> on every page of both layouts. The body-of-page tags
// from Webflow live here too: each one is async or defer, so it does not
// block rendering, and being in <head> only means the browser discovers it
// sooner.
//
// NOT ported from Webflow, deliberately:
//   - jQuery + intl-tel-input. Already on this site without jQuery, in
//     ContactForm.astro, which is the only form with a phone field.
//   - `@font-face { font-display: swap }`. A workaround for Webflow's own
//     font loading; src/styles/global.css already sets font-display on each
//     @font-face it declares.
//   - Weglot (the /es, /ar, /fr ... subdirectory translations and the
//     language switcher). That is a whole multilingual URL structure, not a
//     tag -- none of those URLs exist on this site yet. See the migration
//     notes; it needs its own decision.
//
// Off outside production builds so local development and Vercel previews do
// not write to the live analytics accounts. PUBLIC_DISABLE_ANALYTICS=true
// turns it off in production too, matching PUBLIC_DISABLE_RECAPTCHA.

/** GA4 measurement id and Google Tag id, from the Webflow site's head. */
const GA_IDS = ["G-FW2DRLQJVD", "GT-WB2N5WJ5"];
/** HubSpot portal. The loader pulls in HubSpot's own analytics, collected
 *  forms and cookie banner, which is why only this one script is needed. */
const HUBSPOT_PORTAL_ID = "244306866";
/** RB2B / reb2b -- anonymous-visitor company identification. */
const REB2B_KEY = "R6G5YHZD5D65";
/** Identity Matrix -- visitor identification pixel. */
const IDENTITY_MATRIX_PIXEL = "IM_24471p2b1cp4dbcp8fc8p45ab83285850";
/** Linkbot. */
const LINKBOT_PROPERTY_ID = "45799-b4c2e";
/** Bing Webmaster Tools site verification. */
const BING_SITE_VERIFICATION = "345C486FEB0A731338E5E8061654B647";

const enabled =
  import.meta.env.PROD && import.meta.env.PUBLIC_DISABLE_ANALYTICS !== "true";
---

{/*
  Verification meta stays on every build: it proves domain ownership to Bing
  and sends no data anywhere, so there is nothing to keep out of a preview.
*/}
<meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />

{enabled && (
  <>
    {/* --- Google Analytics 4 --- */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_IDS[0]}`}
    ></script>
    <script is:inline define:vars={{ GA_IDS }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      // `define:vars` compiles this block into an IIFE, so `function gtag()`
      // is local to it -- unlike the top-level snippet Google documents and
      // Webflow shipped. Publish it, or every later `gtag("event", ...)` call
      // on the site throws ReferenceError and the event is silently lost.
      window.gtag = gtag;
      // The two developer ids were set by Webflow's own GA integration; they
      // tag the traffic as coming from a Webflow site. Kept so the historical
      // series in GA stays comparable either side of the migration.
      gtag("set", "developer_id.dZGVlNj", true);
      gtag("set", "developer_id.dYWYxNW", true);
      gtag("js", new Date());
      for (const id of GA_IDS) gtag("config", id);
    </script>

    {/* --- RB2B --- Deferred to window load, as on the Webflow site: it is a
        marketing pixel, and nothing on the page waits for it. */}
    <script is:inline define:vars={{ REB2B_KEY }}>
      window.addEventListener("load", function () {
        !(function () {
          var reb2b = (window.reb2b = window.reb2b || []);
          if (reb2b.invoked) return;
          reb2b.invoked = true;
          reb2b.methods = ["identify", "collect"];
          reb2b.factory = function (method) {
            return function () {
              var args = Array.prototype.slice.call(arguments);
              args.unshift(method);
              reb2b.push(args);
              return reb2b;
            };
          };
          for (var i = 0; i < reb2b.methods.length; i++) {
            var key = reb2b.methods[i];
            reb2b[key] = reb2b.factory(key);
          }
          reb2b.load = function (key) {
            var script = document.createElement("script");
            script.type = "text/javascript";
            script.async = true;
            script.src =
              "https://s3-us-west-2.amazonaws.com/b2bjsstore/b/" + key + "/" + REB2B_KEY + ".js.gz";
            var first = document.getElementsByTagName("script")[0];
            first.parentNode.insertBefore(script, first);
          };
          reb2b.SNIPPET_VERSION = "1.0.1";
          reb2b.load(REB2B_KEY);
        })();
      });
    </script>

    {/* --- Identity Matrix --- */}
    <script
      is:inline
      async
      src={`https://app.identitymatrix.ai/trackingScript.js?pixelid=${IDENTITY_MATRIX_PIXEL}`}
    ></script>

    {/* --- HubSpot --- Also loads HubSpot's cookie-consent banner, which is
        the site's only consent UI. */}
    <script
      is:inline
      id="hs-script-loader"
      async
      defer
      src={`https://js-na2.hs-scripts.com/${HUBSPOT_PORTAL_ID}.js`}
    ></script>

    {/* --- Linkbot --- */}
    <script
      is:inline
      id="pagemapIdscript"
      defer
      src={`https://bot.linkbot.com/bot.js#${LINKBOT_PROPERTY_ID}?property-id=${LINKBOT_PROPERTY_ID}`}
    ></script>
  </>
)}
