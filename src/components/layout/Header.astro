---
import type { SiteNavigation } from "../../lib/types";

interface Props {
  nav: SiteNavigation;
}

const { nav } = Astro.props;
---

<header class="sticky top-0 z-50 bg-secondary/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="shrink-0">
      <img src={nav.logoSrc} alt={nav.logoAlt} class="h-8 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {nav.links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-black/80 transition hover:text-black"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-6 md:flex">
      <a href={`tel:${nav.phone.replace(/[^+\d]/g, "")}`} class="text-sm font-medium text-black/80">
        {nav.phone}
      </a>
      <a
        href={nav.ctaButton.href}
        class="rounded-full bg-primary-green px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-secondary-green"
      >
        {nav.ctaButton.label}
      </a>
    </div>
  </div>
</header>
