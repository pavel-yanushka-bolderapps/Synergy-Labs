---
import type { SiteNavigation } from "../../lib/types";

interface Props {
  nav: SiteNavigation;
}

const { nav } = Astro.props;

// The header's CTA is shared across every page, but the actual contact form
// only lives inline (id="cta") on the homepage -- everywhere else it should
// still go to the standalone /contact page.
const isHome = Astro.url.pathname === "/";
const ctaHref = isHome ? "#cta" : nav.ctaButton.href;
---

<!-- data-nav is the layout mode. It ships as "auto" so the server-rendered
     markup still falls back to the md breakpoint for no-JS and for the frame
     before the script runs; the script then measures and pins it to "desktop"
     or "compact". See the <style> and <script> at the bottom. -->
<header class="sticky top-0 z-50 bg-secondary/90 backdrop-blur" data-nav="auto">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4" data-nav-row>
    <a href="/" class="shrink-0">
      <img src={nav.logoSrc} alt={nav.logoAlt} class="h-8 w-auto md:h-12" />
    </a>

    <nav class="shrink-0 items-center gap-8" data-nav-desktop>
      {nav.links.map((link) =>
        link.children && link.children.length > 0 ? (
          <div class="group relative">
            <span class="flex cursor-pointer items-center gap-1 whitespace-nowrap text-sm font-medium text-black/80 transition hover:text-black">
              {link.label}
              <span class="text-xs transition group-hover:rotate-180">▾</span>
            </span>
            <div class="invisible absolute left-0 top-full z-50 w-max pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
              <div class="min-w-[160px] rounded-lg border border-black/10 bg-white py-2 shadow-lg">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-2 text-sm text-black/80 hover:bg-light-grey hover:text-black"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="flex items-center gap-1.5 whitespace-nowrap text-sm font-medium text-black/80 transition hover:text-black"
          >
            {link.label}
            {link.badge && (
              <span class="rounded-full bg-secondary-green px-1.5 py-0.5 text-[10px] font-semibold uppercase leading-none text-white">
                {link.badge}
              </span>
            )}
          </a>
        )
      )}
    </nav>

    <div class="shrink-0 items-center gap-6" data-nav-desktop>
      <a
        href={`tel:${nav.phone.replace(/[^+\d]/g, "")}`}
        class="whitespace-nowrap text-xs font-medium text-black/80"
      >
        {nav.phone}
      </a>
      <a
        href={ctaHref}
        class="whitespace-nowrap rounded-md bg-secondary-green px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-green"
      >
        {nav.ctaButton.label}
      </a>
    </div>

    <div class="shrink-0 items-center gap-4" data-nav-compact>
      <a
        href={`tel:${nav.phone.replace(/[^+\d]/g, "")}`}
        class="whitespace-nowrap text-xs font-medium text-black/80"
      >
        {nav.phone}
      </a>
      <button
        id="mobile-menu-button"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-md text-black/80 transition hover:text-black"
      >
        <svg data-icon="open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg data-icon="close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="hidden h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="grid grid-rows-[0fr] overflow-hidden opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out"
    data-nav-panel
  >
    <div class="flex flex-col gap-1 overflow-hidden border-t border-black/10 px-6 py-4">
      {nav.links.map((link) =>
        link.children && link.children.length > 0 ? (
          <div>
            <span class="block px-2 py-2 text-sm font-medium text-black/80">{link.label}</span>
            <div class="flex flex-col gap-1 pl-4">
              {link.children.map((child) => (
                <a href={child.href} class="block px-2 py-2 text-sm text-black/70 hover:text-black">
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="flex items-center gap-1.5 px-2 py-2 text-sm font-medium text-black/80 hover:text-black">
            {link.label}
            {link.badge && (
              <span class="rounded-full bg-secondary-green px-1.5 py-0.5 text-[10px] font-semibold uppercase leading-none text-white">
                {link.badge}
              </span>
            )}
          </a>
        )
      )}
      <a
        href={ctaHref}
        class="mt-2 rounded-md bg-secondary-green px-5 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-primary-green"
      >
        {nav.ctaButton.label}
      </a>
    </div>
  </nav>
</header>


<style>
  /* Which of the two headers is showing is driven by data-nav on the header,
     not by a media query, so the switch can happen at the width where the
     links actually stop fitting rather than at a number picked in advance.
     See the script below for how that width is found. */
  header[data-nav="desktop"] [data-nav-desktop] { display: flex; }
  header[data-nav="desktop"] [data-nav-compact] { display: none; }
  header[data-nav="desktop"] [data-nav-panel] { display: none; }

  header[data-nav="compact"] [data-nav-desktop] { display: none; }
  header[data-nav="compact"] [data-nav-compact] { display: flex; }

  /* "auto" is what the server renders and what a reader without JS keeps:
     the md breakpoint this used to switch on. */
  header[data-nav="auto"] [data-nav-desktop] { display: none; }
  header[data-nav="auto"] [data-nav-compact] { display: flex; }

  @media (min-width: 768px) {
    header[data-nav="auto"] [data-nav-desktop] { display: flex; }
    header[data-nav="auto"] [data-nav-compact] { display: none; }
    header[data-nav="auto"] [data-nav-panel] { display: none; }
  }
</style>

<script>
  const menuButton = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const openIcon = menuButton?.querySelector('[data-icon="open"]');
  const closeIcon = menuButton?.querySelector('[data-icon="close"]');

  function setMenuOpen(open: boolean) {
    menuButton?.setAttribute("aria-expanded", String(open));

    // Toggle grid-template-rows between 0fr/1fr: the panel's height animates
    // smoothly via CSS transition without needing to measure its content
    // height in JS (see the `grid grid-rows-[0fr] ... transition-[grid-template-rows,opacity]`
    // classes on #mobile-menu).
    menu?.classList.toggle("grid-rows-[0fr]", !open);
    menu?.classList.toggle("grid-rows-[1fr]", open);
    menu?.classList.toggle("opacity-0", !open);

    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  menuButton?.addEventListener("click", () => {
    setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
  });

  // Collapse to the burger when the links stop fitting, not at 768px.
  //
  // The old md: breakpoint was a guess, and this nav outgrew it: at 712px the
  // links were still "desktop" but had run out of room, so "Our Services" and
  // the phone number wrapped onto two and three lines and the CTA pushed off
  // the edge. The width where it actually stops fitting depends on the link
  // labels, which come from the CMS, and on the font -- none of which a
  // hard-coded breakpoint knows about.
  //
  // Everything in the row is now shrink-0 and whitespace-nowrap, so when it no
  // longer fits it overflows rather than quietly squashing itself, and
  // scrollWidth > clientWidth becomes a reliable "too tight" signal.
  //
  // Going the other way needs a remembered threshold: once collapsed, the
  // desktop row is display:none and can't be measured, so record the width it
  // gave up at and only try again above it. The retry re-measures, so the
  // stored number self-corrects if the labels or fonts change.
  const header = document.querySelector<HTMLElement>("header[data-nav]");
  const row = header?.querySelector<HTMLElement>("[data-nav-row]");

  if (header && row) {
    let collapseAt = Number.POSITIVE_INFINITY;
    let queued = false;

    // Reads layout, so only ever called inside the rAF below. Flipping
    // data-nav and measuring happen in the same frame, so a row that turns out
    // not to fit is never painted in its overflowing state.
    const fitsAsDesktop = () => {
      header.dataset.nav = "desktop";
      return row.scrollWidth <= row.clientWidth + 1;
    };

    const update = () => {
      queued = false;
      const available = row.clientWidth;

      if (header.dataset.nav === "compact" && available <= collapseAt) return;

      if (fitsAsDesktop()) {
        setMenuOpen(false);
      } else {
        collapseAt = available;
        header.dataset.nav = "compact";
      }
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    new ResizeObserver(schedule).observe(row);

    // Metric changes move the threshold, so re-measure once the real faces are
    // in rather than leaving a decision made against the fallback font.
    document.fonts?.ready.then(schedule);
  }
</script>
