---
import type { SiteNavigation } from "../../lib/types";

interface Props {
  nav: SiteNavigation;
}

const { nav } = Astro.props;
---

<header class="sticky top-0 z-50 bg-secondary/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="shrink-0">
      <img src={nav.logoSrc} alt={nav.logoAlt} class="h-8 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {nav.links.map((link) =>
        link.children && link.children.length > 0 ? (
          <div class="group relative">
            <span class="flex cursor-pointer items-center gap-1 text-sm font-medium text-black/80 transition hover:text-black">
              {link.label}
              <span class="text-xs transition group-hover:rotate-180">▾</span>
            </span>
            <div class="invisible absolute left-0 top-full z-50 w-max pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
              <div class="min-w-[160px] rounded-lg border border-black/10 bg-white py-2 shadow-lg">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-2 text-sm text-black/80 hover:bg-light-grey hover:text-black"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="text-sm font-medium text-black/80 transition hover:text-black"
          >
            {link.label}
          </a>
        )
      )}
    </nav>

    <div class="hidden items-center gap-6 md:flex">
      <a href={`tel:${nav.phone.replace(/[^+\d]/g, "")}`} class="text-xs font-medium text-black/80">
        {nav.phone}
      </a>
      <a
        href={nav.ctaButton.href}
        class="rounded-md bg-secondary-green px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-green"
      >
        {nav.ctaButton.label}
      </a>
    </div>
  </div>
</header>
