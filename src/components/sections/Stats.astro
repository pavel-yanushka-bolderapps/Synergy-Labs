---
import type { HomeStatsContent } from "../../lib/types";

interface Props {
  content: HomeStatsContent;
}

const { content } = Astro.props;
---

<section class="border-b border-black/5 bg-secondary">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-6 py-12 sm:grid-cols-3">
    {content.items.map((item) => (
      <div class="flex flex-col items-center text-center">
        <img src={item.iconSrc} alt="" class="h-25 w-25" />
        <p class="mt-3 font-display text-3xl text-primary-green md:text-4xl">{item.value}</p>
        <p class="mt-1 text-sm text-black/60">{item.label}</p>
      </div>
    ))}
  </div>
</section>
