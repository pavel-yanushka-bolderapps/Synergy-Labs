---
// The homepage/contact-page band: the green pitch panel on one side, the
// shared form on the other. The form itself now lives in ContactForm.astro
// so the location pages can reuse it in their hero.
import ContactForm from "../ContactForm.astro";
import { nav } from "../../content/nav";

interface Props {
  // Anchor id this section is targeted by (e.g. header/CTA buttons link to
  // `#${id}`). The standalone /contact page uses "contact"; the section
  // embedded on the homepage uses "cta" so on-page buttons can jump straight
  // to it.
  id?: string;
  heading?: string;
  /**
   * Heading level for the pitch panel. This band is appended to thirteen
   * different page types, and it used to print its pitch as an <h1> on every
   * one of them -- so /about-us, /awards, /blog, every blog listing page,
   * every case study and every service page shipped two <h1> elements, the
   * second one saying "Partner with a top-tier agency" rather than anything
   * about the page. It is a section heading everywhere except /contact, where
   * the band *is* the page.
   */
  headingLevel?: "h1" | "h2";
}

const {
  id = "contact",
  heading = "Partner with a top-tier agency",
  headingLevel: Heading = "h2",
} = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-6 py-20">
  <div id="contact-form-wrapper" class="grid grid-cols-1 gap-6 min-[760px]:grid-cols-2">
    <div class="relative order-2 overflow-hidden rounded-3xl bg-secondary-green p-10 text-white shadow-xl min-[760px]:order-1 md:p-8">
      <img
        src="/images/Hero-Bg.svg"
        alt=""
        class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      />
      <div class="relative flex h-full flex-col">
        <Heading class="font-display text-3xl leading-tight md:text-4xl">{heading}</Heading>

        <p class="mt-8 text-white/90">Ready to get started on your project?</p>
        <p class="mt-4 text-white/90">
          <strong class="font-semibold">Schedule a meeting via the form here</strong> and you'll connect directly
          with our director of product -- no salespeople involved.
        </p>

        <p class="mt-8 text-white/90">Prefer to talk now?</p>
        <p class="mt-4 text-white/90">
          Give us a call at
          {" "}
          <a href={`tel:+1${nav.phone.replace(/[^+\d]/g, "")}`} class="font-semibold hover:underline">
            +1 {nav.phone}
          </a>
        </p>

        <div class="mt-auto flex flex-wrap items-center gap-4 pt-10">
          <img src="/images/contact-form-badge-01.svg" alt="Sortlist Verified Agency" class="h-10 w-auto" />

          <div class="clutch-badge flex items-center gap-3 rounded-xl bg-[#17232c] px-4 py-3">
            <a
              href="https://clutch.co/profile/synergy-labs?utm_source=widget&utm_medium=14&utm_campaign=widget&utm_content=logo&utm_term=www.synergylabs.co"
              aria-label="Synergy Labs on Clutch"
              rel="nofollow noopener noreferrer"
              target="_blank"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white"
            >
              <span class="relative font-display text-lg font-bold leading-none text-[#17232c]">
                C
                <span class="absolute -right-0.5 top-1/2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-[#ff3722]"></span>
              </span>
            </a>

            <div>
              <div class="flex items-center gap-1.5">
                <p class="text-sm font-bold leading-none text-white">4.9</p>
                <a
                  href="https://clutch.co/profile/synergy-labs?utm_source=widget&utm_medium=14&utm_campaign=widget&utm_content=stars&utm_term=www.synergylabs.co#reviews"
                  rel="nofollow noopener noreferrer"
                  target="_blank"
                  class="flex items-center gap-0.5"
                  aria-label="4.9 out of 5 stars"
                >
                  {[100, 100, 100, 100, 90].map((fillPercent) => (
                    <span class="relative inline-block h-3 w-3">
                      <svg viewBox="0 0 20 20" class="absolute inset-0 h-3 w-3 text-white/25" fill="currentColor">
                        <path d="M10 1.6l2.53 5.62 6.13.57-4.63 4.15 1.36 6.06L10 14.97l-5.39 3.03 1.36-6.06L1.34 7.79l6.13-.57L10 1.6z" />
                      </svg>
                      <span class="absolute inset-0 overflow-hidden" style={`width:${fillPercent}%`}>
                        <svg viewBox="0 0 20 20" class="h-3 w-3 text-[#ff3722]" fill="currentColor">
                          <path d="M10 1.6l2.53 5.62 6.13.57-4.63 4.15 1.36 6.06L10 14.97l-5.39 3.03 1.36-6.06L1.34 7.79l6.13-.57L10 1.6z" />
                        </svg>
                      </span>
                    </span>
                  ))}
                </a>
              </div>
              <a
                href="https://clutch.co/profile/synergy-labs?utm_source=widget&utm_medium=14&utm_campaign=widget&utm_content=num_reviews&utm_term=www.synergylabs.co#reviews"
                rel="nofollow noopener noreferrer"
                target="_blank"
                class="mt-1 block text-xs text-white/70 hover:text-white"
              >
                Based on 45 Clutch reviews
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>


    <ContactForm class="order-1 overflow-hidden rounded-3xl bg-secondary p-5 shadow-xl min-[760px]:order-2 md:p-8" />
  </div>

  <div id="contact-success" class="hidden flex-col items-center rounded-3xl bg-secondary p-10 text-center shadow-xl md:p-16">
    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-secondary-green text-white">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-8 w-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
    </div>
    <h2 class="mt-6 font-display text-3xl md:text-4xl">Thanks -- we got your message!</h2>
    <p class="mt-4 max-w-md text-black/70">
      Our director of product will reach out shortly to schedule your call. In the meantime, feel free to give us
      a call at {" "}
      <a href={`tel:+1${nav.phone.replace(/[^+\d]/g, "")}`} class="font-semibold text-secondary-green">
        +1 {nav.phone}
      </a>.
    </p>
  </div>
</section>

