---
// The "why work with us" row on a service detail page: white cards on the
// brand green, each with an icon, a heading and a short line. Content comes
// from the `valueCards` array on the service document in Sanity.
//
// Icons are inline SVG keyed by name rather than uploaded images: they are
// small marks that must sit exactly on the brand green and stay crisp at any
// size, and picking from a short list is a far better editing experience
// than asking an editor to source an SVG. ICONS below is the whole set --
// adding one here means also adding it to the dropdown in
// src/sanity/schemaTypes/service.ts so editors can actually choose it.
import type { ServiceValueCard } from "../../lib/types";

interface Props {
  cards: ServiceValueCard[];
}

const { cards } = Astro.props;

const ICONS: Record<string, string> = {
  tools: `<path fill-rule="evenodd" d="M14.5 10a4.5 4.5 0 0 0 4.284-5.882c-.105-.324-.51-.391-.751-.15L15.34 6.66a.45.45 0 0 1-.493.11a3 3 0 0 1-1.618-1.616a.455.455 0 0 1 .11-.494l2.694-2.692c.24-.241.174-.647-.15-.752a4.5 4.5 0 0 0-5.873 4.575c.055.873-.128 1.808-.8 2.368l-7.23 6.024a2.724 2.724 0 1 0 3.837 3.837l6.024-7.23c.56-.672 1.495-.855 2.368-.8q.144.01.291.01M5 16a1 1 0 1 1-2 0a1 1 0 0 1 2 0" clip-rule="evenodd"/><path d="M14.5 11.5q.26 0 .514-.022l3.754 3.754a2.5 2.5 0 0 1-3.536 3.536l-4.41-4.41l2.172-2.607c.052-.062.147-.138.342-.196a2.3 2.3 0 0 1 .777-.067q.192.012.387.012M6 4.586l2.33 2.33a.5.5 0 0 1-.08.09L6.8 8.214L4.586 6H3.309a.5.5 0 0 1-.447-.276l-1.7-3.402a.5.5 0 0 1 .093-.577l.49-.49a.5.5 0 0 1 .577-.094l3.402 1.7A.5.5 0 0 1 6 3.31z"/>`,
  clock: `<path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16a8 8 0 0 0 0 16m.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25z" clip-rule="evenodd"/>`,
  shield: `<path fill-rule="evenodd" d="M9.661 2.237a.531.531 0 0 1 .678 0a11.95 11.95 0 0 0 7.078 2.749a.5.5 0 0 1 .479.425a12 12 0 0 1 .144 1.852c0 5.016-3.08 9.312-7.453 11.1a.55.55 0 0 1-.394 0C5.82 16.575 2.74 12.279 2.74 7.263c0-.63.049-1.249.144-1.852a.5.5 0 0 1 .479-.425a11.95 11.95 0 0 0 7.078-2.749zm4.108 5.783a.75.75 0 0 0-1.214-.882l-3.483 4.79l-1.88-1.88a.75.75 0 1 0-1.061 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089z" clip-rule="evenodd"/>`,
  rocket: `<path fill-rule="evenodd" d="M9.315 7.584C12.195 4.703 16.045 3.5 19.5 3.5a.75.75 0 0 1 .75.75c0 3.456-1.203 7.305-4.084 10.186a12 12 0 0 1-1.877 1.535q.043.194.043.398V19a.75.75 0 0 1-.375.65l-2.5 1.444A.75.75 0 0 1 10.35 20.5l-.6-1.8l-2.45-2.45l-1.8-.6a.75.75 0 0 1-.494-1.107l1.444-2.5A.75.75 0 0 1 7.1 11.67h2.63q.204 0 .398.043a12 12 0 0 1 1.535-1.877zM15 9.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3" clip-rule="evenodd"/>`,
  users: `<path d="M10 9a3 3 0 1 0 0-6a3 3 0 0 0 0 6M6 8a2 2 0 1 1-4 0a2 2 0 0 1 4 0m-4.51 7.326a.78.78 0 0 1-.358-.442a3 3 0 0 1 4.308-3.516a6.5 6.5 0 0 0-1.905 3.959q-.02.116-.028.238a5 5 0 0 1-2.017-.24zm14.95.24l-.005-.083a.4.4 0 0 0-.024-.155a6.5 6.5 0 0 0-1.905-3.96a3 3 0 0 1 4.308 3.517a.78.78 0 0 1-.357.442a5 5 0 0 1-2.018.24zM18 8a2 2 0 1 1-4 0a2 2 0 0 1 4 0M5.304 16.19a.84.84 0 0 1-.277-.71a5 5 0 0 1 9.947 0a.84.84 0 0 1-.277.71A6.98 6.98 0 0 1 10 18a6.97 6.97 0 0 1-4.696-1.81"/>`,
  chart: `<path fill-rule="evenodd" d="M2 10a8 8 0 1 1 16 0a8 8 0 0 1-16 0m6.5-3.5a.75.75 0 0 1 .75.75v6.5a.75.75 0 0 1-1.5 0v-6.5a.75.75 0 0 1 .75-.75m3.75 2.75a.75.75 0 0 0-1.5 0v4.5a.75.75 0 0 0 1.5 0zm-7.5 2.5a.75.75 0 0 0-1.5 0v2a.75.75 0 0 0 1.5 0zm10.5-4.5a.75.75 0 0 1 .75.75v8.25a.75.75 0 0 1-1.5 0V8a.75.75 0 0 1 .75-.75" clip-rule="evenodd"/>`,
};

const FALLBACK_ICON = "tools";
---

{cards.length > 0 && (
  <section class="relative overflow-hidden bg-secondary-green">
    <img
      src="/images/Hero-Bg.svg"
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-80"
    />

    <div class="relative mx-auto max-w-7xl px-6 py-20 md:py-28">
      <ul class="grid gap-6 md:grid-cols-3 md:gap-8">
        {cards.map((card) => (
          <li class="flex flex-col items-center rounded-3xl bg-white px-8 py-12 text-center text-secondary-green">
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
              class="h-10 w-10"
              set:html={ICONS[card.icon] ?? ICONS[FALLBACK_ICON]}
            />
            <h3 class="mt-8 font-display text-2xl leading-tight md:text-3xl">{card.title}</h3>
            {card.description && (
              <p class="mt-6 text-secondary-green/80">{card.description}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
