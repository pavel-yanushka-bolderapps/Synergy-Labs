---
import type { HomeLocationsContent } from "../../lib/types";

interface Props {
  content: HomeLocationsContent;
}

const { content } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20">
  <h2 class="font-display text-3xl md:text-4xl">
    Our <span class="text-secondary-green">Locations</span>
  </h2>

  <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {content.items.map((loc) => (
      <div class="group relative overflow-hidden rounded-2xl">
        {loc.imageSrc && (
          <img src={loc.imageSrc} alt={loc.city} class="h-48 w-full object-cover transition duration-300 group-hover:scale-105" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        {loc.isHeadquarters && (
          <span class="absolute left-4 top-4 rounded-full bg-secondary-green px-3 py-1 text-xs font-semibold text-white">
            HEADQUARTERS
          </span>
        )}
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <p class="font-display text-lg">{loc.city}</p>
          <p class="text-xs text-white/80">{loc.address}</p>
        </div>
      </div>
    ))}
  </div>
</section>
