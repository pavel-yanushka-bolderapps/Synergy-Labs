---
// The homepage's Locations section. The grid itself lives in
// locations/LocationsGrid.astro, shared with /locations -- this is just the
// heading and the band around it.
import LocationsGrid from "./locations/LocationsGrid.astro";
import type { HomeLocationsContent } from "../../lib/types";

interface Props {
  content: HomeLocationsContent;
}

const { content } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20">
  <h2 class="font-display text-3xl md:text-4xl">
    Our <span class="text-secondary-green">Locations</span>
  </h2>

  <div class="mt-10">
    <LocationsGrid
      items={content.items}
      moreLabel={content.moreLocationsLabel}
      moreHref="/locations"
    />
  </div>
</section>
