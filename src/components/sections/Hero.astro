---
import Lottie from "../Lottie.astro";
import type { HomeHeroContent } from "../../lib/types";

interface Props {
  content: HomeHeroContent;
}

const { content } = Astro.props;
const lines = content.heading.split("\n");
---

<section class="relative overflow-hidden bg-green-50">
  <!--
    Hero-Bg.svg is a bespoke 1440x1024 desktop drawing (an inset grid with a
    fixed line pitch), not a tileable pattern. `object-cover` on a tall narrow
    mobile section scales it to the section *height* and crops ~440px off each
    side, so the designed frame disappears and the surviving lines read as a
    random oversized grid. Scale it to the section width on mobile instead --
    the grid then lands as a band in the middle of the hero, as designed.
  -->
  <img src={content.bgImageSrc} alt="" class="pointer-events-none absolute inset-0 h-full w-full object-contain md:object-cover opacity-40" />
  <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-24">
    <div class="flex flex-col items-center text-center md:block md:text-start">
      <h1 class="font-display text-4xl leading-tight md:text-5xl">
        {lines.map((line, i) => (
          <>
            {line}
            {i < lines.length - 1 && <br />}
          </>
        ))}
      </h1>
      <a
        href={content.ctaButton.href}
        class="mt-8 inline-block rounded-md bg-secondary-green px-8 py-4 font-semibold text-white transition hover:bg-primary-green"
      >
        {content.ctaButton.label}
      </a>
    </div>
    <div class="flex justify-center md:justify-end">
      <!--
        The visual is a square that tracks the column width and caps at the
        25.75rem the desktop layout was built around. It used to be a hard
        25.75rem at every breakpoint, which is wider than the content area on
        any phone -- so the phones broke out of the px-6 gutter every other
        element lines up to, and rendered ~20% oversized against the original.

        Everything layered on top is therefore sized in percentages: the still
        iPhone has to stay locked to the slot the Lottie carousel leaves open
        at the centre, and px offsets only held at exactly 412px.
      -->
      <div class="relative flex aspect-square w-full max-w-[25.75rem] items-center justify-center">
        <Lottie src="/lottie/hero-animation.lottie" class="h-full w-full" />
        <img
          src={content.phoneImageSrc}
          alt="Synergy Labs app preview"
          class="absolute left-[37.04%] top-[22.96%] h-[53.88%] w-auto"
        />
      </div>
    </div>
  </div>
</section>
