---
import type { HomeBadgesContent } from "../../lib/types";

interface Props {
  content: HomeBadgesContent;
}

const { content } = Astro.props;

// Duplicate the badge list once so the marquee can scroll exactly -50% and
// loop seamlessly back to an identical starting frame.
const track = [...content.badges, ...content.badges];
---

<section class="overflow-hidden bg-secondary py-16">
  <div class="mx-auto max-w-7xl px-6 text-center">
    <h2 class="font-display text-3xl md:text-4xl">{content.heading}</h2>
  </div>

  <div class="badges-carousel relative mt-10 max-w-7xl px-6 overflow-hidden ml-auto mr-auto">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-secondary to-transparent md:w-32"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-secondary to-transparent md:w-32"></div>

    <div class="badges-track flex w-max items-center gap-8 sm:gap-12 md:gap-16">
      {track.map((badge) => (
        <img src={badge} alt="" class="h-32 w-auto shrink-0 object-contain md:h-48 lg:h-64" />
      ))}
    </div>
  </div>
</section>

<style>
  .badges-carousel {
    overflow: hidden;
  }

  .badges-track {
    animation: badges-scroll 30s linear infinite;
  }

  .badges-carousel:hover .badges-track {
    animation-play-state: paused;
  }

  @keyframes badges-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Track is the badge list duplicated once, so -50% lands exactly on
         an identical repeat of the first copy -- a seamless loop. */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badges-track {
      animation: none;
    }
  }
</style>
