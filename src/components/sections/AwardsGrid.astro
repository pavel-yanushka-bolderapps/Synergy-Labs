---
import type { AwardItem } from "../../lib/types";

interface Props {
  items: AwardItem[];
}

const { items } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20">
  <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <li class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-xl transition hover:shadow-2xl">
        <div class="flex h-56 items-center justify-center bg-green-50 p-8">
          <img
            src={item.imageSrc}
            alt={`${item.organization} — ${item.title}`}
            loading="lazy"
            class="h-full w-auto max-w-full object-contain transition duration-500 ease-out group-hover:scale-105"
          />
        </div>

        <div class="flex flex-1 flex-col p-8">
          <h3 class="font-display text-2xl leading-tight">{item.organization}</h3>
          <p class="mt-3 text-black/70">{item.title}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
