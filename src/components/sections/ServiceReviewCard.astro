---
// One client review: five stars, the quote, and the client's photo, name and
// role. Used by both layouts in ServiceTestimonials.astro so a review looks
// the same wherever it sits.
import type { ServiceTestimonial } from "../../lib/types";

interface Props {
  item: ServiceTestimonial;
}

const { item } = Astro.props;

const STAR =
  "M8.16379 0.551109C8.47316 -0.183704 9.52684 -0.183703 9.83621 0.551111L11.6621 4.88811C11.7926 5.19789 12.0875 5.40955 12.426 5.43636L17.1654 5.81173C17.9684 5.87533 18.294 6.86532 17.6822 7.38306L14.0713 10.4388C13.8134 10.6571 13.7007 10.9996 13.7795 11.3259L14.8827 15.8949C15.0696 16.669 14.2172 17.2809 13.5297 16.8661L9.47208 14.4176C9.18225 14.2427 8.81775 14.2427 8.52793 14.4176L4.47029 16.8661C3.7828 17.2809 2.93036 16.669 3.11727 15.8949L4.22048 11.3259C4.29928 10.9996 4.18664 10.6571 3.92873 10.4388L0.317756 7.38306C-0.294046 6.86532 0.0315611 5.87533 0.834562 5.81173L5.57402 5.43636C5.91255 5.40955 6.20744 5.19789 6.33786 4.88811L8.16379 0.551109Z";
---

<figure class="flex flex-col justify-between rounded-3xl border-2 border-black bg-light-grey p-6 md:p-10">
  <div>
    <div class="flex gap-1 text-[#fcd462]" role="img" aria-label="5 out of 5 stars">
      {[0, 1, 2, 3, 4].map(() => (
        <svg viewBox="0 0 18 17" fill="currentColor" aria-hidden="true" class="h-6 w-6 md:h-8 md:w-8">
          <path d={STAR}></path>
        </svg>
      ))}
    </div>
    <blockquote class="mt-6 font-display text-lg leading-snug md:text-xl">&ldquo;{item.quote}&rdquo;</blockquote>
  </div>

  <figcaption class="mt-6 flex items-center gap-4 font-display md:mt-8">
    {item.avatarSrc && (
      <img
        src={item.avatarSrc}
        alt=""
        loading="lazy"
        width="64"
        height="64"
        class="h-14 w-14 shrink-0 rounded-full border-2 border-black object-cover md:h-16 md:w-16"
      />
    )}
    <span>
      <span class="block">{item.name}</span>
      {item.role && <span class="block">{item.role}</span>}
    </span>
  </figcaption>
</figure>
