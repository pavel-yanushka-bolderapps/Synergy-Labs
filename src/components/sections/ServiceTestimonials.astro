---
// Client review cards on a service detail page, from the `testimonials*`
// fields on the service document in Sanity. Where the section sits on the
// page is the page's business (see the placement switch in
// src/pages/our-services/[slug].astro); this only draws it.
//
// Two layouts, both transcribed from the original Webflow service pages:
//   stacked  -- full-width cards one under another (mobile, staff
//               augmentation, custom software).
//   showcase -- the marketing page's grid: the first two reviews framed by
//               rating tiles, the logo and the designer animation. The tiles
//               are marketing copy no other page uses, so they live here
//               rather than as fields every service would carry.
import Lottie from "../Lottie.astro";
import ServiceReviewCard from "./ServiceReviewCard.astro";
import type { ServiceTestimonialsContent } from "../../lib/types";

interface Props {
  content: ServiceTestimonialsContent;
}

const { content } = Astro.props;
const [first, second] = content.items;

// The original tiles used an icon font that no longer loads -- the live site
// shows empty squares -- so these are inline stand-ins for what each says.
const TILE_ICONS = {
  users: `<path d="M10 9a3 3 0 1 0 0-6a3 3 0 0 0 0 6M6 8a2 2 0 1 1-4 0a2 2 0 0 1 4 0m-4.51 7.326a.78.78 0 0 1-.358-.442a3 3 0 0 1 4.308-3.516a6.5 6.5 0 0 0-1.905 3.959q-.02.116-.028.238a5 5 0 0 1-2.017-.24zm14.95.24l-.005-.083a.4.4 0 0 0-.024-.155a6.5 6.5 0 0 0-1.905-3.96a3 3 0 0 1 4.308 3.517a.78.78 0 0 1-.357.442a5 5 0 0 1-2.018.24zM18 8a2 2 0 1 1-4 0a2 2 0 0 1 4 0M5.304 16.19a.84.84 0 0 1-.277-.71a5 5 0 0 1 9.947 0a.84.84 0 0 1-.277.71A6.98 6.98 0 0 1 10 18a6.97 6.97 0 0 1-4.696-1.81"/>`,
  star: `<path transform="translate(1 1.5)" d="M8.16379 0.551109C8.47316 -0.183704 9.52684 -0.183703 9.83621 0.551111L11.6621 4.88811C11.7926 5.19789 12.0875 5.40955 12.426 5.43636L17.1654 5.81173C17.9684 5.87533 18.294 6.86532 17.6822 7.38306L14.0713 10.4388C13.8134 10.6571 13.7007 10.9996 13.7795 11.3259L14.8827 15.8949C15.0696 16.669 14.2172 17.2809 13.5297 16.8661L9.47208 14.4176C9.18225 14.2427 8.81775 14.2427 8.52793 14.4176L4.47029 16.8661C3.7828 17.2809 2.93036 16.669 3.11727 15.8949L4.22048 11.3259C4.29928 10.9996 4.18664 10.6571 3.92873 10.4388L0.317756 7.38306C-0.294046 6.86532 0.0315611 5.87533 0.834562 5.81173L5.57402 5.43636C5.91255 5.40955 6.20744 5.19789 6.33786 4.88811L8.16379 0.551109Z"/>`,
  rocket: `<path fill-rule="evenodd" transform="translate(-2 -2)" d="M9.315 7.584C12.195 4.703 16.045 3.5 19.5 3.5a.75.75 0 0 1 .75.75c0 3.456-1.203 7.305-4.084 10.186a12 12 0 0 1-1.877 1.535q.043.194.043.398V19a.75.75 0 0 1-.375.65l-2.5 1.444A.75.75 0 0 1 10.35 20.5l-.6-1.8l-2.45-2.45l-1.8-.6a.75.75 0 0 1-.494-1.107l1.444-2.5A.75.75 0 0 1 7.1 11.67h2.63q.204 0 .398.043a12 12 0 0 1 1.535-1.877zM15 9.5a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3" clip-rule="evenodd"/>`,
};

const ANIMATION = "/lottie/marketing-designer.json";

const greenTile =
  "tile-green flex flex-col items-center justify-center gap-2 rounded-3xl p-8 text-center font-display text-white";
const whiteTile =
  "flex flex-col items-center justify-center gap-2 rounded-3xl border border-black bg-white p-8 text-center font-display";
const illustrationTile = "aspect-square overflow-hidden rounded-3xl border border-black bg-[#65966f]";
---

{content.layout === "showcase" && first ? (
  <section class="mx-auto max-w-7xl px-6 py-16 md:py-20" aria-label="Client reviews">
    <div class="grid gap-6 md:grid-cols-[1fr_1fr_1.6fr]">
      <div class={greenTile}>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-12 w-12" set:html={TILE_ICONS.users} />
        <p class="text-4xl md:text-5xl">50+</p>
        <p class="text-lg tracking-wider md:text-xl">Happy Customers</p>
      </div>
      <div class={whiteTile}>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-12 w-12 text-[#fcd462]" set:html={TILE_ICONS.star} />
        <p class="text-4xl md:text-5xl">5/5</p>
        <p class="text-lg tracking-wider md:text-xl">average rating</p>
      </div>
      <ServiceReviewCard item={first} />
    </div>

    <!-- On a phone the logo takes its own full row above the two
         illustrations; from md up it sits between them as in the original. -->
    <div class="mt-6 grid grid-cols-2 items-center gap-6 md:grid-cols-[1fr_2fr_1fr]">
      <div class={illustrationTile}>
        <Lottie src={ANIMATION} class="h-full w-full" />
      </div>
      <img
        src="/images/Logo-Transp-BG.webp"
        alt="Synergy Labs"
        loading="lazy"
        class="order-first col-span-2 mx-auto w-full max-w-md object-contain md:order-none md:col-span-1"
      />
      <div class={illustrationTile}>
        <Lottie src={ANIMATION} class="h-full w-full -scale-x-100" />
      </div>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-[1.6fr_1fr_1fr]">
      {second && <ServiceReviewCard item={second} />}
      <div class={whiteTile}>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-12 w-12 text-[#fcd462]" set:html={TILE_ICONS.star} />
        <p class="text-4xl md:text-5xl">5/5</p>
        <p class="text-lg tracking-wider md:text-xl">average rating</p>
      </div>
      <div class={greenTile}>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-12 w-12" set:html={TILE_ICONS.rocket} />
        <p class="text-lg tracking-wider md:text-xl">From planning to promotion — we launch your brand</p>
      </div>
    </div>
  </section>
) : (
  <section class="mx-auto max-w-7xl px-6 py-16 md:py-20" aria-label="Client reviews">
    <div class="flex flex-col gap-6 md:gap-12">
      {content.items.map((item) => <ServiceReviewCard item={item} />)}
    </div>
  </section>
)}

<style>
  /* The original's green tiles carry a soft lighter glow (two blurred radial
     images over the brand green); two gradients get the same read without
     the extra requests. */
  .tile-green {
    background:
      radial-gradient(circle at 70% 25%, rgb(120 160 90 / 0.55), transparent 55%),
      radial-gradient(circle at 30% 80%, rgb(120 160 90 / 0.35), transparent 50%),
      var(--color-secondary-green);
  }
</style>
