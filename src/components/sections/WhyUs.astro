---
import type { HomeWhyUsContent } from "../../lib/types";

interface Props {
  content: HomeWhyUsContent;
}

const { content } = Astro.props;
const lastIndex = content.rows.length - 1;
---

<section class="@container mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-display text-3xl font-bold uppercase md:text-4xl">{content.heading}</h2>

  <table class="mt-10 w-full table-fixed border-separate border-spacing-0">
    <thead>
      <tr>
        <th class="w-1/3 p-0"><span class="sr-only">Comparison</span></th>
        <th class="w-1/3 p-0 pb-3 pl-2 text-left font-normal sm:pl-6 md:pb-4">
          <span class="flex items-center gap-1.5 sm:gap-2">
            <img src="/images/People.avif" alt="" class="h-[6cqw] w-[6cqw] max-h-6 min-h-4 max-w-6 min-w-4 shrink-0" />
            <span class="font-display text-[clamp(0.7rem,4cqw,1.25rem)] leading-tight">Other agencies</span>
          </span>
        </th>
        <th class="w-1/3 p-0 pb-3 pl-2 text-left font-normal sm:pl-6 md:pb-4">
          <span class="flex items-center gap-1.5 sm:gap-2">
            <img src="/images/favicon.png" alt="" class="h-[6cqw] w-[6cqw] max-h-6 min-h-4 max-w-6 min-w-4 shrink-0" />
            <span class="font-display text-[clamp(0.7rem,4cqw,1.25rem)] leading-tight">SynergyLabs</span>
          </span>
        </th>
      </tr>
    </thead>
    <tbody class="overflow-hidden rounded-2xl border-2 border-secondary-green sm:rounded-3xl [&>tr:first-child>td:first-child]:rounded-tl-[1.1rem] [&>tr:first-child>td:last-child]:rounded-tr-[1.1rem] [&>tr:last-child>td:first-child]:rounded-bl-[1.1rem] [&>tr:last-child>td:last-child]:rounded-br-[1.1rem] sm:[&>tr:first-child>td:first-child]:rounded-tl-[1.35rem] sm:[&>tr:first-child>td:last-child]:rounded-tr-[1.35rem] sm:[&>tr:last-child>td:first-child]:rounded-bl-[1.35rem] sm:[&>tr:last-child>td:last-child]:rounded-br-[1.35rem]">
      {content.rows.map((row, i) => (
        <tr>
          <td
            class:list={[
              "break-words bg-secondary-green p-3 text-[clamp(0.75rem,3.6cqw,1rem)] font-semibold leading-snug text-white sm:p-6",
              i !== lastIndex && "border-b border-white/10",
            ]}
          >
            {row.label}
          </td>
          <td
            class:list={[
              "border-r border-black/10 bg-white p-3 text-[clamp(0.7rem,3.4cqw,0.95rem)] leading-snug text-black/60 sm:p-6",
              i !== lastIndex && "border-b border-black/10",
            ]}
          >
            <div class="flex items-center gap-1.5 sm:gap-3">
              <img src="/images/No-Icon.avif" alt="" class="h-[7cqw] w-[7cqw] max-h-7 min-h-5 max-w-7 min-w-5 shrink-0" />
              <span class="break-words">{row.otherAgencies}</span>
            </div>
          </td>
          <td
            class:list={[
              "break-words bg-white p-3 text-[clamp(0.7rem,3.4cqw,0.95rem)] font-semibold leading-snug text-primary-green sm:p-6",
              i !== lastIndex && "border-b border-black/10",
            ]}
          >
            <div class="flex items-center gap-1.5 sm:gap-3">
              <img src="/images/Yes-Icon.avif" alt="" class="h-[7cqw] w-[7cqw] max-h-7 min-h-5 max-w-7 min-w-5 shrink-0" />
              <span class="break-words">{row.synergyLabs}</span>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</section>
