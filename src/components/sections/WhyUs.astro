---
import type { HomeWhyUsContent } from "../../lib/types";

interface Props {
  content: HomeWhyUsContent;
}

const { content } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="text-center font-display text-3xl md:text-4xl">{content.heading}</h2>

  <div class="mt-12 overflow-x-auto rounded-2xl border border-black/10">
    <table class="w-full min-w-[560px] border-collapse text-sm">
      <thead>
        <tr>
          <th class="p-4 text-left font-medium text-black/50"></th>
          <th class="bg-light-grey p-4 text-left font-semibold text-black/70">Other agencies</th>
          <th class="bg-secondary-green p-4 text-left font-semibold text-white">Synergy Labs</th>
        </tr>
      </thead>
      <tbody>
        {content.rows.map((row) => (
          <tr class="border-t border-black/10">
            <td class="p-4 font-medium text-black/70">{row.label}</td>
            <td class="bg-light-grey/60 p-4 text-black/60">{row.otherAgencies}</td>
            <td class="bg-secondary-green/5 p-4 font-semibold text-primary-green">{row.synergyLabs}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
