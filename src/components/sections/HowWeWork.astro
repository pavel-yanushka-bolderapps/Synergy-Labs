---
import type { HomeHowWeWorkContent } from "../../lib/types";

interface Props {
  content: HomeHowWeWorkContent;
}

const { content } = Astro.props;
---

<section class="relative overflow-hidden bg-secondary-green py-20 text-white">
  <img
    src="/images/Hero-Bg.svg"
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
  />

  <div class="relative mx-auto flex max-w-7xl flex-col gap-10 px-6 md:flex-row md:items-start md:gap-16">
    <h2 class="font-display text-3xl md:w-1/3 md:shrink-0 md:text-4xl">{content.heading}</h2>

    <div class="flex flex-1 flex-col gap-10">
      {content.steps.map((step) => (
        <div class="flex flex-col gap-2 pt-8 first:border-t-0 first:pt-0 md:flex-row md:items-start md:gap-6">
          <span class="font-display text-[4.5rem] leading-none text-white/10 font-sans">{step.number}</span>
          <div>
            <h3 class="text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 max-w-2xl text-sm text-white/70">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
