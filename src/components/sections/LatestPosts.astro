---
// The homepage's "News & Insights" row: the three newest posts, with a link
// out to the full archive. The cards are the same ones /blog uses.
import BlogCard from "./blog/BlogCard.astro";
import type { BlogPostSummary } from "../../lib/types";

interface Props {
  posts: BlogPostSummary[];
  heading?: string;
}

const { posts, heading = "News & Insights" } = Astro.props;
---

{posts.length > 0 && (
  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <h2 class="font-display text-3xl uppercase md:text-4xl">{heading}</h2>
      <a
        href="/blog"
        class="inline-block rounded-md bg-secondary-green px-8 py-4 text-sm font-semibold text-white transition hover:bg-primary-green"
      >
        Read more
      </a>
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <li>
          <BlogCard post={post} headingLevel="h3" />
        </li>
      ))}
    </ul>
  </section>
)}
