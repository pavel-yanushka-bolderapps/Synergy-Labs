# Copy this file to .env (and to your Vercel project's Environment
# Variables) and fill in real values. Never commit the real .env file --
# it's already in .gitignore.

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys, from
# https://www.google.com/recaptcha/admin
# The site key is safe to expose to the browser -- it's rendered directly
# into the contact page's HTML.
# Set to "true" to temporarily skip reCAPTCHA entirely (useful for local
# testing before your site key's domain allowlist / keys are sorted out).
# Leave unset or "false" everywhere else -- it disables spam protection.
PUBLIC_DISABLE_RECAPTCHA=false

PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# The secret key must NEVER be exposed to the browser. It's only read
# server-side in src/pages/api/contact.ts.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Resend (https://resend.com) API key for sending the contact-form email.
RESEND_API_KEY=re_your_resend_api_key

# Where contact-form submissions get emailed.
CONTACT_TO_EMAIL=you@example.com

# Optional: the "from" address on the email Resend sends. Until you verify
# your own sending domain in Resend, leave this unset -- it defaults to
# Resend's shared onboarding@resend.dev test sender, which works for
# development but will look unpolished/land in spam more easily in
# production. Once you verify a domain (e.g. synergylabs.com) in the Resend
# dashboard, set this to something like:
# CONTACT_FROM_EMAIL="Synergy Labs <hello@synergylabs.com>"
CONTACT_FROM_EMAIL=Synergy Labs <onboarding@resend.dev>

# Sanity (https://sanity.io) -- CMS for editable content, starting with the
# homepage Services grid. Create a free project at sanity.io/manage (or via
# `npx sanity init` if you'd rather do it from the CLI), then copy its
# Project ID and dataset name (usually "production") here.
# Both values are safe to expose to the browser -- they're identifiers, not secrets.
PUBLIC_SANITY_PROJECT_ID=toot3mhg
PUBLIC_SANITY_DATASET=production

# --- Studio "Preview" tab (Sanity Presentation / Visual Editing) ---
# Set to "true" to enable the Preview tab at /studio: the live site in an
# iframe next to the editor, with click-to-edit overlays on Sanity-backed
# text. Turning this on makes pages fetch DRAFT content and embeds invisible
# "stega" metadata in the rendered strings, so keep it OFF (unset) for the
# production build -- it is meant for local development and preview
# deployments only.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Required whenever PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true, because
# unpublished drafts are not publicly readable. Create one at
# https://sanity.io/manage -> your project -> the API tab -> Tokens ->
# "Add API token", with the **Viewer** role. Server-only -- never expose it
# to the browser. Without it the Preview tab still loads, but shows
# published content with no click-to-edit.
SANITY_API_READ_TOKEN=sk5jx1H8toHe3hOZbWkZ8r9YbJYnOhfKwE5i1ZbF5BYZF8EXFgsqJBxHn5ItcRzBJSgjJbuM86YLayHy9UXkHll2uu4VWIKxhwlW8sOEujQMWKcyL4Kw3kGutuIG2Yx5iiVddyq9G8T8J3Ou4xcIsN04MXSN6LVenk6JeLDtBKfPtslkX46v
